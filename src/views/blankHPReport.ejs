<!DOCTYPE html>
<html>
  <head>
    <style>
      @page {
        margin-bottom: 55px;
        margin-top: 20vh;
      }
      body {
        font-family: Arial, sans-serif;
        font-size: 14px;
        margin: 20px;
        line-height: 1.6;
      }

      .report-content {
        margin-top: 30px;
      }

      h1,
      h2 {
        margin-bottom: 20px;
        text-align: left;
        clear: both;
      }

      h1 {
        font-size: 24px;
      }

      h2 {
        font-size: 18px;
        color: #0066cc;
      }

      p {
        font-size: 14px;
        margin-bottom: 10px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
        border: 1px solid #000;
      }

      th,
      td {
        border: 1px solid #000;
        padding: 10px;
        /* text-align: left; */
        text-align: center;
        height: 24px;
      }

      th {
        background-color: #f8f8f8;
        font-weight: bold;
      }

      .remarks {
        page-break-inside: avoid;
      }

      .heading {
        padding-top: 35px;
      }
    </style>
  </head>
  <body>
    <div class="report-content">
      <% if (arrayData && arrayData.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Sr. No</th>
            <th>Date</th>
            <th>Sample Name</th>
            <th>Reg No./Lot No. </th>
            <th>Method Used</th>
            <th>Parameter / Activity</th>
            <th>Column No.</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>No. of Injection</th>
            <th>Done By</th>
            <th>Checked By </th>
            <th>Remarks</th>
          </tr>
        </thead>
        <tbody>
          <% arrayData.forEach(record => { %>
          <tr>
            <td><%= record?.s_no %></td>
            <td><%= record?.date %></td>
            <td><%= record?.sample_name %></td>
            <td><%= record?.reg_no %></td>
            <td><%= record?.method_used %></td>
            <td><%= record?.parameter_or_activity %></td>
            <td><%= record?.column_no %></td>
            <td><%= record?.start_time %></td>
            <td><%= record?.end_time %></td>
            <td><%= record?.no_of_injections %></td>
            <td><%= record?.done_by %></td>
            <td><%= record?.checked_by %></td>
            <td><%= record?.remarks %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </body>
</html>

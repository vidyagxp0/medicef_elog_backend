<style>
  .footer-container {
    width: 100%;
    margin: 0 40px;
    padding-top: 6px;
    border-top: 1px solid #cbd5e1;
    font-family: 'Segoe UI', Roboto, Arial, sans-serif;
    font-size: 11px;
    color: #475569;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
    -webkit-print-color-adjust: exact;
  }
  .footer-left {
    font-weight: 500;
  }
  .footer-center {
    font-weight: 600;
    color: #0f172a;
  }
  .footer-right {
    font-weight: 500;
  }
  .pageNumber, .totalPages {
    font-weight: 700;
    color: #0f172a;
  }
</style>

<div class="footer-container">
  <span class="footer-left">Printed on: <%= date %></span>
  <span class="footer-center">Page <span class="pageNumber"></span> of <span class="totalPages"></span></span>
  <span class="footer-right">Printed by: <%= userName || 'System User' %></span>
</div>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Report Header</title>

    <style>
      body {
        margin: 0;
        font-family: "Segoe UI", -apple-system, Roboto, Helvetica, Arial, sans-serif;
      }

      .header-container {
        width: 100%;
        padding: 0 40px;
        box-sizing: border-box;
      }

      .header-table {
        width: 100%;
        border-collapse: collapse;
        /* text-align: left; */
        font-size: 13px;
        table-layout: fixed;
      }

      .header-table th,
      .header-table td {
        border: 1px solid #42454a;
        padding: 6px 10px;
        vertical-align: middle;
      }

      .company-name {
        font-size: 18px;
        font-weight: 700;
        text-align: center;
        color: #0f172a;
      }

      .company-address {
        font-size: 12.5px;
        font-weight: 400;
        color: #2c333e;
        margin-top: 3px;
        display: block;
      }

      .header-logo {
        width: 110px;
        text-align: center;
        background-color: #f8fafc;
      }

      .header-logo img {
        max-width: 90px;
        max-height: 45px;
        object-fit: contain;
      }

      .header-info {
        font-size: 12px;
        text-align: center;
        color: #293442;
        background-color: #f8fafc;
      }

      .label {
        font-weight: 600;
        color: #0f172a;
      }
    </style>
  </head>

  <body>
    <div class="header-container">
      <table class="header-table">
        <tr>
          <th colspan="2">
            <div class="company-name">
              Medicef Pharma
              <span class="company-address">
                Plot No. 28, 29, 48, EPIP Phase-I, Jharmajri, Baddi, Dist. Solan (H.P.)
              </span>
            </div>
          </th>

          <th rowspan="2" class="header-logo">
            <% if (logoDataUri) { %>
              <img src="<%= logoDataUri %>" alt="Company Logo" />
            <% } else { %>
              <span style="font-weight: bold; color: #0284c7;">MEDICEF</span>
            <% } %>
          </th>
        </tr>

        <tr>
          <td class="header-info">
            <span class="label">Department:</span>
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>

          <td class="header-info">
            <span class="label">Process:</span>
            <%= reportData?.Process?.process || "Not Applicable" %>
          </td>
        </tr>
      </table>
    </div>
  </body>
</html>

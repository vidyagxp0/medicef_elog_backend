<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #000;
      margin: 25px;
      line-height: 1.6;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }
    h3.subheading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 14px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      /* border: 1px solid #000; */
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 8px;
      /* text-align: left; */
      font-size: 13px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: center;
      vertical-align: middle;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /*  DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }
  </style>
</head>

<body>

  <% const formatDateTime=(date)=> {
        if (!date) return "Not Applicable";
        return new Date(date).toLocaleString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
        }).replace(/\//g, "-");
        };

        const formatDateOnly = (date) => {
        if (!date) return "Not Applicable";
        return new Date(date).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        }).replace(/\//g, "-");
        };
        %>



    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/CDR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Cleaning and Disinfectant solution preparation distribution and destruction Records</h2>
        <h3 class="subheading">Part-I</h3>

    <% if (reportData.CleaningAndDisinfectantRecords && reportData.CleaningAndDisinfectantRecords.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th rowspan="3">S. No.</th>
            <th rowspan="3">Unique ID</th>
            <th rowspan="3">Date</th>
            <th rowspan="3">Name of Solution</th>
            <th rowspan="3">Concentration Of Solution</th>
            <th colspan="1"></th>
            <th colspan="1"></th>
            <th colspan="2">Quantity of Cleaning/Disinfectant solution Prepared </th>
          </tr>
          <tr>
            <th rowspan="2">Volume of Disinfectant /Cleaning Solution</th>
            <th rowspan="2">Volume of Purified Water</th>
            <th rowspan="2">Prepared By</th>
            <th rowspan="2">Checked By</th>
          </tr>
        </thead>
        <tbody>

          <% reportData.CleaningAndDisinfectantRecords.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
              <td>
                <%= record?.unique_id || "Not Applicable" %>
              </td>
              <td>
                <%= formatDateOnly(record?.date) || "Not Applicable" %>
              </td>
              <td>
                <%= record?.name_of_solution || "Not Applicable" %>
              </td>
              <td>
                <%= record?.concentration_of_solution || "Not Applicable" %>
              </td>
              <td>
                <%= record?.volume_of_disinfectant || "Not Applicable" %>
              </td>
              <td>
                <%= record?.volume_of_purified || "Not Applicable" %>
              </td>
              <td>
                <%= record?.prepared_by || "Not Applicable" %>
              </td>
              <td>
                <%= record?.reviewed_by || "Not Applicable" %>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>

      <h3 class="subheading">Part-II</h3>

  <% if (reportData.CleaningAndDisinfectantRecords && reportData.CleaningAndDisinfectantRecords.length> 0) { %>
      <table>
        <thead>
           <tr>
            <th rowspan="3">S. No.</th>
            <th colspan="5">Quantity of Cleaning/Disinfectant solution Prepared</th>
            <th colspan="1">After the Hold Time Quantity of solution destroyed</th>
            <th rowspan="3">Remarks </th>
          </tr>
          <tr>
            <th rowspan="2">Total Volume of Solution</th>
            <th colspan="2">Distribution Record</th>
            <th rowspan="2">Date</th>
            <th rowspan="2">Remaining Quantity destroyed</th>
            <th rowspan="2">Destroyed by</th>
          </tr>
          <tr>
            <th rowspan="2">Quantity</th>
            <th rowspan="2">Department/Area</th>
 
          </tr>
        </thead>
        <tbody>

          <% reportData.CleaningAndDisinfectantRecords.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
              <td>
                <%= record?.total_volume_of_solution || "Not Applicable" %>
              </td>
              <td>
                <%= record?.quantity || "Not Applicable" %>
              </td>
              <td>
                <%= record?.department_area || "Not Applicable" %>
              </td>
              <td>
                  <%= formatDateOnly(record?.prepared_date) || "Not Applicable" %>

              </td>
              <td>
                <%= record?.remaining_qty_destroyed || "Not Applicable" %>
              </td>
                <td>
                  <%= record?.destroyed_by || "Not Applicable" %>
                </td>
               
                <td>
                  <%= record?.remarks || "Not Applicable" %>
                </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>

          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      Not Applicable
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

            <% } %>


</body>

</html>
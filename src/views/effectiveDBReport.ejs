<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #000;
      margin: 25px;
      line-height: 1.6;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
    }
    h3.subheading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 14px;
      background-color: #e9ecef;
      margin-bottom: 8px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 8px;
      /* text-align: left; */
      font-size: 13px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: center;
      vertical-align: middle;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /*  DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }
  </style>
</head>

<body>

  <% const formatDateOnly=(date)=> {
    if (!date) return "Not Applicable";
    return new Date(date).toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    }).replace(/\//g, "-");    };
    %>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/DBR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Dispensing Booth Area</td>
          <td class="value">
            <%= reportData?.dispensingBoothArea || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Dispensing Booth ID</td>
          <td class="value">
            <%= reportData?.dispensingBoothID || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Dispensing Booth Activity Records</h2>
        <h3 class="subheading">Part-I</h3>
    <% if (reportData.DispensingBoothRecords && reportData.DispensingBoothRecords.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th rowspan="2">S. No.</th>
            <th rowspan="2">Unique ID</th>
            <th rowspan="2">Date</th>
            <th rowspan="2">RLAF start time</th>
            <th colspan="3">Filter Reading</th>
            <th rowspan="2">Product</th>
            <th rowspan="2">Batch No.</th>
            <th rowspan="2">Batch Size</th>
            <th rowspan="2">Dispensing Start time</th>
            

          </tr>
          <tr>  
            <th>Pre Filter</th>
            <th>Intermediate Filter</th>
            <th>HEPA Filter</th>
          </tr>
        </thead>
        <tbody>

          <% reportData.DispensingBoothRecords.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
              <td>
                <%= record?.unique_id || "Not Applicable" %>
              </td>
              <td style="word-break: keep-all;">
                <%= formatDateOnly(record?.date) || "Not Applicable" %>
              </td>
              <td>
                <%= record?.rlaf_start_time || "Not Applicable" %>
              </td>
              <td>
                <%= record?.pre_filter || "Not Applicable" %>
              </td>
              <td>
                <%= record?.intermediate_filter || "Not Applicable" %>
              </td>
              <td>
                <%= record?.hepa_filter || "Not Applicable" %>
              </td>
              <td>
                <%= record?.product || "Not Applicable" %>
              </td>
              <td>
                <%= record?.batch_no || "Not Applicable" %>
              </td>
              <td>
                <%= record?.batch_size || "Not Applicable" %>
              </td>
               <td>
                <%= record?.dispensing_start_time || "Not Applicable" %>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>
        <h3 class="subheading">Part-II</h3>
    <% if (reportData.DispensingBoothRecords && reportData.DispensingBoothRecords.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th rowspan="2">S. No.</th>
            <th rowspan="2">Dispensing End time</th>
            <th rowspan="2">RLAF end time</th>
            <th rowspan="2">Dispensing done by</th>
            <th rowspan="2">Dispensing verified by</th>
            <th rowspan="2">Type of cleaning A/B</th>
            <th colspan="4">Dispensing Booth cleaning</th>
            <th rowspan="2">Remark</th>

          </tr>
          <tr>  
            <th>Start Time</th>
            <th>End Time</th>
            <th>Done By</th>
            <th>Verified By</th>
          </tr>
        </thead>
        <tbody>

          <% reportData.DispensingBoothRecords.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
           
              <td>
                <%= record?.dispensing_end_time || "Not Applicable" %>
              </td>
              <td>
                <%= record?.rlaf_end_time || "Not Applicable" %>
              </td>
                 <td>
                <%= record?.dispensing_doneby || "Not Applicable" %>
              </td>
              <td>
                <%= record?.dispensing_verifiedby || "Not Applicable" %>
              </td>
              <td>
                <%= record?.type_of_cleaning || "Not Applicable" %>
              </td>
              <td>
                <%= record?.dbc_start_time || "Not Applicable" %>
              </td>
              <td>
                <%= record?.dbc_end_time || "Not Applicable" %>
              </td>
              <td>
                <%= record?.dbc_doneby || "Not Applicable" %>
              </td>
              <td>
                  <%= record?.dbc_verifiedby || "Not Applicable" %>
              </td>
              <td>
                  <%= record?.remarks || "Not Applicable" %>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>


          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      Not Applicable
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

            <% } %>


</body>

</html>
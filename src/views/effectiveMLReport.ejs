<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #000;
      margin: 25px;
      line-height: 1.6;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }
    h3.subheading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 14px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      /* border: 1px solid #000; */
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 8px;
      /* text-align: left; */
      font-size: 13px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: center;
      vertical-align: middle;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /*  DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }
  </style>
</head>

<body>

  <% const formatDateOnly=(date)=> {
    if (!date) return "Not Applicable";
    return new Date(date).toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    }).replace(/\//g, "-");    };
    %>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/MLR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Microbial Limit Test Sample Records</h2>
    <h3 class="subheading">Part-I</h3>
    <% if (reportData.MicrobialLimitRecords && reportData.MicrobialLimitRecords.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th>S. No.</th>
            <th>Unique ID</th>
            <th>Date</th>
            <th>Product Name</th>
            <th>Batch No.</th>
            <th>Mfg. Date</th>
            <th>Exp. Date</th>
            <th>A.R. No.</th>
            <th>Analysis Date</th>
            <th>Analyzed By</th>
            <th>Results of TBC CFU/g or ml</th>
            <th>Observed By</th>
            <th>Results of TFC CFU/g or ml</th>
            <th>Observed By</th>
          </tr>
        </thead>
        <tbody>

          <% reportData.MicrobialLimitRecords.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
              <td>
                <%= record?.unique_id || "Not Applicable" %>
              </td>
              <td>
                <%= formatDateOnly(record?.date) || "Not Applicable" %>
              </td>
              <td>
                <%= record?.product_name || "Not Applicable" %>
              </td>
              <td>
                <%= record?.batch_no || "Not Applicable" %>
              </td>
              <td>
                <%= record?.mfg_date || "Not Applicable" %>
              </td>
              <td>
                <%= record?.exp_date || "Not Applicable" %>
              </td>
              <td>
                <%= record?.ar_no || "Not Applicable" %>
              </td>
              <td>
                <%= formatDateOnly(record?.analysis_date) || "Not Applicable" %>
              </td>
              <td>
                <%= record?.analyzed_by || "Not Applicable" %>
              </td>
              <td>
                <%= record?.results_of_tbc || "Not Applicable" %>
              </td>
              <td>
                <%= record?.observed1_by || "Not Applicable" %>
              </td>
              <td>
                <%= record?.results_of_tfc || "Not Applicable" %>
              </td>
              <td>
                <%= record?.observed2_by || "Not Applicable" %>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>

        <h3 class="subheading">Part-II</h3>
    <% if (reportData.MicrobialLimitRecords && reportData.MicrobialLimitRecords.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th>S. No.</th>
            <th>E. coli</th>
            <th>Salmonella</th>
            <th>P. Aeruginosa</th>
            <th>S. aureus</th>
            <th>Shigella boydii</th>
            <th>C. albicans</th>
            <th>Clostridia</th>
            <th>Bile Tolerant Gram –ve bacteria</th>
            <th>Date Of Release	</th>
            <th>Checked By</th>
            <th>Remark</th>
          </tr>
        </thead>
        <tbody>

          <% reportData.MicrobialLimitRecords.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
              <td>
                <%= record?.e_coli || "Not Applicable" %>
              </td>
              <td>
                <%= record?.salmonella || "Not Applicable" %>
              </td>
              <td>
                <%= record?.p_aeruginosa || "Not Applicable" %>
              </td>
              <td>
                <%= record?.s_aureus || "Not Applicable" %>
              </td>
              <td>
                <%= record?.shigellaboydii || "Not Applicable" %>
              </td>
              <td>
                <%= record?.c_albicans || "Not Applicable" %>
              </td>
                <td>
                  <%= record?.clostridia || "Not Applicable" %>
                </td>
                <td>
                  <%= record?.bile_tolerant || "Not Applicable" %>
                </td>
                <td>
                  <%= record?.date_of_release || "Not Applicable" %>
                </td>
                <td style="text-align: center;">
                  <% if (record?.reviewed_by) { 
                       const parts = record.reviewed_by.split(" | ");
                       const reviewerName = parts[0];
                       const reviewerDateTime = parts[1] || (record.updatedAt ? new Date(record.updatedAt).toLocaleString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", second: "2-digit" }).replace(/\//g, "-").replace(",", "") : "");
                  %>
                    <div style="font-weight: 600;"><%= reviewerName %></div>
                    <% if (reviewerDateTime) { %>
                      <div style="font-size: 10px; color: #555; margin-top: 2px;"><%= reviewerDateTime %></div>
                    <% } %>
                  <% } else { %>
                    Not Applicable
                  <% } %>
                </td>
                <td>
                  <%= record?.remarks || "Not Applicable" %>
                </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>

          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      Not Applicable
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

            <% } %>


</body>

</html>
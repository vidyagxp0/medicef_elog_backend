<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: Arial, sans-serif;
      font-size: 14px;
      margin: 20px;
      line-height: 1.6;
    }

    .report-content {
      margin-top: 30px;
    }

    h2 {
      margin-bottom: 20px;
      text-align: center;
      color: #0066CC;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
      border: 1px solid #000;
    }

    th, td {
      border: 1px solid #000;
      padding: 8px;
      font-size: 13px;
      text-align: left;
    }

    th {
      background-color: #d9d7d7;
      font-weight: bold;
    }

    .green { color: green; font-weight: bold; }
    .red { color: red; font-weight: bold; }
    .black { color: black; font-weight: bold; }

    .performance-box {
      background: #fff6d9;
      font-size: 12px;
    }

    .center {
      text-align: center;
    }
  </style>
</head>

<body>
<div class="report-content">
  <h2>HPLC Records</h2>

  <% if (reportData.hplcRecords && reportData.hplcRecords.length > 0) { %>
  <table>
    <thead>
      <tr>
        <th>S.No</th>
        <th>Date</th>
        <th>Instrument Name</th>
        <th>Instrument No.</th>
        <th>Sample Name</th>
        <th>Reg/Lot No.</th>
        <th>Method Used</th>
        <th>Parameter</th>
        <th>Column No.</th>
        <th></th>
      </tr>

      <tr>
        <th></th>
        <th>Performance</th>
        <th>Start Time</th>
        <th>End Time</th>
        <th>Injections</th>
        <th>Done By</th>
        <th>Checked By</th>
        <th>Remark</th>
        <th>Attachment</th>
        <th>Status</th>
      </tr>
    </thead>

    <tbody>
    <% reportData.hplcRecords.forEach((record, index) => { %>

      <!-- MAIN ROW -->
      <tr>
        <td><%= index + 1 %></td>
        <td><%= record?.date || "Not Applicable" %></td>
        <td><%= record?.instrument_name || "Not Applicable" %></td>
        <td><%= record?.instrument_no || "Not Applicable" %></td>
        <td><%= record?.sample_name || "Not Applicable" %></td>
        <td><%= record?.reg_no || "Not Applicable" %></td>
        <td><%= record?.method_used || "Not Applicable" %></td>
        <td><%= record?.parameter_or_activity || "Not Applicable" %></td>
        <td><%= record?.column_no || "Not Applicable" %></td>
      </tr>

      <!-- SECOND ROW -->
      <tr>
        <td></td>
        <td><%= record?.performance || "Not Applicable" %></td>
        <td><%= record?.start_time ? record.start_time.split(':').slice(0,2).join(':') : "N/A" %></td>
        <td><%= record?.end_time ? record.end_time.split(':').slice(0,2).join(':') : "N/A" %></td>
        <td><%= record?.no_of_injections || "Not Applicable" %></td>
        <td><%= record?.done_by || "Not Applicable" %></td>
        <td><%= record?.reviewed_by || "Not Applicable" %></td>
        <td><%= record?.remarks || record?.remarksOther || "Not Applicable" %></td>

        <td>
          <% if (record?.supporting_docs) { %>
            <a href="<%= record.supporting_docs %>" target="_blank">
              <%= record.supporting_docs.split('/').pop() %>
            </a>
          <% } else { %>
            Not Applicable
          <% } %>
        </td>
        <td><%= record?.status || "Not Applicable" %></td>
      </tr>

      <!-- DYNAMIC PERFORMANCE DETAIL ROW -->
      <% if (record?.performance && record.performance !== "OK") { %>
      <tr class="performance-box">
        <td colspan="2">Performance Details</td>

        <td colspan="3">
          <strong>Start Date & Time:</strong><br>
          <%= record?.performanceStartTime || "Not Applicable" %>
        </td>

        <td colspan="3">
          <strong>End Date & Time:</strong><br>
          <%= record?.performanceEndDateTime || "Not Applicable" %>
        </td>

        <td colspan="2">
          <strong>Remark:</strong><br>
          <%= record?.performanceRemark || "Not Applicable" %>
        </td>
      </tr>
      <% } %>

    <% }) %>
    </tbody>
  </table>

  <% } else { %>
    <p>No Records Found.</p>
  <% } %>

</div>
</body>
</html>

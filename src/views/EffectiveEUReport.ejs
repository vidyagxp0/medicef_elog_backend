<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #000;
      margin: 20px;
      line-height: 1.5;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 20px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    h3.subheading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 14px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 6px;
      font-size: 12px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: center;
      vertical-align: middle;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /* DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    /* RECORDS TABLE */
    .records-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      page-break-inside: auto;
    }

    .records-table th,
    .records-table td {
      border: 1px solid #000;
      padding: 6px 4px;
      font-size: 11px;
      vertical-align: middle;
      box-sizing: border-box;
    }

    .records-table th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: center;
      font-size: 11px;
    }

    .col-sno {
      width: 35px;
      text-align: center;
      white-space: nowrap;
    }

    .col-uid {
      width: 70px;
      text-align: center;
      white-space: nowrap;
    }

    .col-date {
      width: 75px;
      text-align: center;
      white-space: nowrap;
    }

    .col-product {
      min-width: 135px;
      white-space: nowrap;
      text-align: left;
    }

    .col-batch {
      min-width: 85px;
      white-space: nowrap;
      text-align: center;
    }

    .col-activity {
      min-width: 80px;
      text-align: center;
      white-space: nowrap;
    }

    .col-time {
      width: 60px;
      text-align: center;
      white-space: nowrap;
    }

    .col-done {
      min-width: 80px;
      text-align: center;
    }

    .col-checked {
      min-width: 90px;
      text-align: center;
    }

    .col-verified {
      min-width: 90px;
      text-align: center;
    }

    .col-remark {
      min-width: 90px;
      text-align: left;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }
  </style>
</head>

<body>

    <% const formatDateTime=(date)=> {
        if (!date) return "NA";
        return new Date(date).toLocaleString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
}).replace(/\//g, "-");        };

        const formatDateOnly = (date) => {
        if (!date) return "NA";
        return new Date(date).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
}).replace(/\//g, "-");        };
        %>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/EUR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Initiator name</td>
          <td class="value">
            <%= reportData?.initiator_name || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Initiation Date</td>
          <td class="value">
            <%= formatDateTime(reportData?.date_of_initiation) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room Id</td>
          <td class="value">
            <%= reportData?.room_id || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Equipment Name</td>
          <td class="value">
            <%= reportData?.equipmentName || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Equipment Id</td>
          <td class="value">
            <%= reportData?.equipmentID || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "NA" %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Equipment Usage Records</h2>
    <% if (reportData.EquipmentUsageRecords && reportData.EquipmentUsageRecords.length> 0) { %>
      <table class="records-table">
        <thead>
          <tr>
            <th class="col-sno">Sr. No.</th>
            <th class="col-uid">Unique ID</th>
            <th class="col-date">Date</th>
            <th class="col-product">Product Name</th>
            <th class="col-batch">Batch No.</th>
            <th class="col-activity">Activity Type</th>
            <th class="col-time">Start Time</th>
            <th class="col-time">End Time</th>
            <th class="col-done">Done By</th>
            <th class="col-checked">Checked By</th>
            <th class="col-verified">Verified By</th>
            <th class="col-remark">Remark</th>
          </tr>
        </thead>
        <tbody>

          <% reportData.EquipmentUsageRecords.forEach((record, index)=> { %>
            <tr>
              <td class="col-sno">
                <%= index + 1 %>
              </td>
              <td class="col-uid">
                <%= record?.unique_id || "NA" %>
              </td>
              <td class="col-date">
                <%= formatDateOnly(record?.date) || "NA" %>
              </td>
              <td class="col-product">
                <%= record?.productName || "NA" %>
              </td>
              <td class="col-batch">
                <%= record?.batchNo || "NA" %>
              </td>
              <td class="col-activity">
                <%= record?.activityType || "NA" %>
              </td>
              <td class="col-time">
                <%= record?.startTime || "NA" %>
              </td>
              <td class="col-time">
                <%= record?.endTime || "NA" %>
              </td>
              <td class="col-done">
                <%= record?.done_by || "NA" %>
              </td>
              <td class="col-checked">
                <% if (record?.reviewed_by) { 
                     const parts = record.reviewed_by.split(" | ");
                %>
                  <div><%= parts[0] %></div>
                  <% if (parts[1]) { %>
                    <div><%= parts[1] %></div>
                  <% } %>
                <% } else { %>
                  NA
                <% } %>
              </td>
              <td class="col-verified">
                <% if (record?.verified_by) { 
                     const parts = record.verified_by.split(" | ");
                %>
                  <div><%= parts[0] %></div>
                  <% if (parts[1]) { %>
                    <div><%= parts[1] %></div>
                  <% } %>
                <% } else { %>
                  NA
                <% } %>
              </td>
              <td class="col-remark">
                <%= record?.remarks || "NA" %>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
      <% } %>

      <!-- ================= ADDITIONAL ================= -->
      <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

        <h2 class="heading">Additional</h2>
        <table>
          <tr>
            <th>Additional Attachment</th>
            <td>
              <% if (reportData?.additionalAttachment) { %>
                <a href="<%= reportData.additionalAttachment %>" target="_blank">
                  View File
                </a>
              <% } else { %>
                NA
              <% } %>
            </td>
          </tr>

          <tr>
            <th>Additional Info</th>
            <td>
              <%= reportData?.additionalInfo || "NA" %>
            </td>
          </tr>
        </table>

      <% } %>

</body>

</html>
<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #000;
      margin: 25px;
      line-height: 1.6;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }
    h3.subheading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 14px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      /* border: 1px solid #000; */
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 8px;
      /* text-align: left; */
      font-size: 13px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: center;
      vertical-align: middle;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /*  DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }
  </style>
</head>

<body>

    <% const formatDateTime=(date)=> {
        if (!date) return "NA";
        return new Date(date).toLocaleString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
}).replace(/\//g, "-");        };

        const formatDateOnly = (date) => {
        if (!date) return "NA";
        return new Date(date).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
}).replace(/\//g, "-");        };
        %>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
            <tr>
                <td class="label">Record Id</td>
                <td class="value">
                    MED/EUR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
                </td>
            </tr>
            <tr>
                <td class="label">Initiator name</td>
                <td class="value">
                    <%= reportData?.initiator_name || "NA" %>
                </td>
            </tr>
            <tr>
                <td class="label">Initiation Date</td>
                <td class="value">
                    <%= formatDateTime(reportData?.date_of_initiation) %>
                </td>
            </tr>
            <tr>
                <td class="label">Area Name</td>
                <td class="value">
                    <%= reportData?.area_name || "NA" %>
                </td>
            </tr>
            <tr>
                <td class="label">Room Id</td>
                <td class="value">
                    <%= reportData?.room_id || "NA" %>
                </td>
            </tr>
               <tr>
                <td class="label">Equipment Name</td>
                <td class="value">
                    <%= reportData?.equipmentName || "NA" %>
                </td>
            </tr>
            <tr>
                <td class="label">Equipment Id</td>
                <td class="value">
                    <%= reportData?.equipmentID || "NA" %>
                </td>
            </tr>
         
            <tr>
                <td class="label">Department</td>
                <td class="value">
                    <%= reportData?.departmentName || "NA" %>
                </td>
            </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Equipment Usage Records</h2>
     <!-- <h3 class="subheading">Part-I</h3> -->
    <% if (reportData.EquipmentUsageRecords && reportData.EquipmentUsageRecords.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th>Sr. No.</th>
            <th>Unique ID</th>
            <th style="width: 10%;">Date</th>
            <th>Product Name</th>
            <th>Batch No.</th>
            <th>Activity Type</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Done By</th>
            <th>Checked By</th>
            <th>Verified By</th>
            <th>Remark</th>
          </tr>
        </thead>
        <tbody>

          <% reportData.EquipmentUsageRecords.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
              <td>
                <%= record?.unique_id || "NA" %>
              </td>
              <td>
                <%= formatDateOnly(record?.date) || "NA" %>
              </td>
                <td>
                  <%= record?.productName || "NA" %>
                </td>
                <td>
                  <%= record?.batchNo || "NA" %>
                </td>
                <td>
                  <%= record?.activityType || "NA" %>
                </td>
                 <td>
                  <%= record?.startTime || "NA" %>
                </td>
                <td>
                  <%= record?.endTime || "NA" %>
                </td>
                <td>
                  <%= record?.done_by || "NA" %>
                </td>
                <td>
                  <%= record?.reviewed_by || "NA" %>
                </td>
                <td>
                  <%= record?.verified_by || "NA" %>
                </td>
                <td>
                  <%= record?.remarks || "NA" %>
                </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>

          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      NA
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "NA" %>
                </td>
              </tr>
            </table>

            <% } %>


</body>

</html>
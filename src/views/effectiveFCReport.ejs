<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 12px;
      color: #000;
      margin: 25px;
      line-height: 1.35;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      /* border: 1px solid #000; */
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 5px;
      /* text-align: left; */
      font-size: 11px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: left;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /* 🔥 DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }

    h1 {
      font-size: 18px;
    }

    h2.heading {
      font-size: 13.5px;
      padding: 5px 8px;
    }    
  </style>
</head>

<body>

    <% const formatDateTime=(date)=> {
        if (!date) return "Not Applicable";
        return new Date(date).toLocaleString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
        }).replace(/\//g, "-");
        };

        const formatDateOnly = (date) => {
        if (!date) return "Not Applicable";
        return new Date(date).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        }).replace(/\//g, "-");
        };
        %>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
            <tr>
                <td class="label">Record Id</td>
                <td class="value">
                    MED/FCR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
                </td>
            </tr>
            <tr>
                <td class="label">Initiator name</td>
                <td class="value">
                    <%= reportData?.initiator_name || "Not Applicable" %>
                </td>
            </tr>
            <tr>
                <td class="label">Initiation Date</td>
                <td class="value">
                    <%= formatDateTime(reportData?.date_of_initiation) %>
                </td>
            </tr>
            <tr>
                <td class="label">Area Name</td>
                <td class="value">
                    <%= reportData?.area_name || "Not Applicable" %>
                </td>
            </tr>
            <tr>
                <td class="label">Room Id</td>
                <td class="value">
                    <%= reportData?.room_id || "Not Applicable" %>
                </td>
            </tr>
            <!-- <tr>
                <td class="label">Instrument Id</td>
                <td class="value">
                    <%= reportData?.instrumentID || "Not Applicable" %>
                </td>
            </tr> -->
            <tr>
                <td class="label">Department</td>
                <td class="value">
                    <%= reportData?.departmentName || "Not Applicable" %>
                </td>
            </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Filter Cleaning Records</h2>

<% if (reportData.filterCleaningRecords && reportData.filterCleaningRecords.length > 0) { %>
<table>
  <thead>
    <tr>
      <th rowspan="3" >S.No</th>
      <th rowspan="3" >Unique ID</th>
      <th rowspan="3" >Date</th>
      <th rowspan="3" >Equipment id</th>
      <th colspan="9">Pre & return riser filters</th>
      <th colspan="6">Fine filters</th>
      <th rowspan="3" >Done by</th>
      <th rowspan="3" >Checked By</th>
      <th rowspan="3" >Remarks</th>
    </tr>
    <tr>
      <th colspan="2">Pre filter</th>
      <th colspan="2">Return riser filter</th>
      <th rowspan="2">Cleaning start time</th>
      <th rowspan="2">Cleaning completion time</th>
      <th rowspan="2">Physical condition of filter after cleaning</th>
      <th rowspan="2">Drying start time</th>
      <th rowspan="2">Drying stop time</th>
      <th colspan="2">Fine filter</th>
      <th rowspan="2">Cleaning start time</th>
      <th rowspan="2">Cleaning completion time</th>
      <th rowspan="2">Physical condition of filter after cleaning</th>
    </tr>
    <tr>
     <th>Filter id no.</th>
     <th>Qty. of filters</th>
     <th>Filter id no.</th>
     <th>Qty. of filters</th>
     <th>Filter id no.</th>
     <th>Qty. of filters</th>

    </tr>
  </thead>

  <tbody>
    <% reportData.filterCleaningRecords.forEach((record, index) => { %>
    <tr>
      <td><%= index + 1 %></td>
      <td><%= record?.unique_id || "Not Applicable" %></td>
      <td><%= formatDateOnly(record?.date) || "Not Applicable" %></td>
      <td><%= record?.equipmentID || "Not Applicable" %></td>
      <td><%= record?.preFilterID || "Not Applicable" %></td>
      <td><%= record?.preFilterQty || "Not Applicable" %></td>
      <td><%= record?.returnRiserFilterID || "Not Applicable" %></td>
      <td><%= record?.returnRiserFilterQty || "Not Applicable" %></td>
     
      <td><%= record?.cleaningStartTime || "Not Applicable" %></td>
      <td><%= record?.cleaningEndTime || "Not Applicable" %></td>
      <td><%= record?.physicalCondition || "Not Applicable" %></td>
      <td><%= record?.dryingStartTime || "Not Applicable" %></td>
      <td><%= record?.dryingStopTime || "Not Applicable" %></td>
      <td><%= record?.fineFilterID || "Not Applicable" %></td>
      <td><%= record?.fineFilterQty || "Not Applicable" %></td>
      <td><%= record?.fineCleaningStart || "Not Applicable" %></td>
      <td><%= record?.fineCleaningEnd || "Not Applicable" %></td>
      <td><%= record?.finePhysicalCondition || "Not Applicable" %></td>
      <td><%= record?.done_by || "Not Applicable" %></td>
      <td><%= record?.reviewed_by || "Not Applicable" %></td>
      <td><%= record?.remarks || "Not Applicable" %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } else { %>
<p>No Records Found.</p>
<% } %>

          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      Not Applicable
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

            <% } %>


</body>

</html>
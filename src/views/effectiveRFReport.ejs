<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #000;
      margin: 25px;
      line-height: 1.6;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }
    h3.subheading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 14px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      /* border: 1px solid #000; */
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 8px;
      /* text-align: left; */
      font-size: 13px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: left;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /*  DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }
  </style>
</head>

<body>

  <% const formatDateOnly=(date)=> {
    if (!date) return "Not Applicable";
    return new Date(date).toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    }).replace(/\//g, "-");    };
    %>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/RFR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Returned Finished Goods Register Records</h2>
    <% if (reportData.ReturnedFinishedRecords && reportData.ReturnedFinishedRecords.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th>S. No.</th>
            <th>Unique ID</th>
            <th>Date</th>
            <th>Product Name and Item Code</th>
            <th>Batch No.</th>
            <th>Mfg. Date</th>
            <th>Exp. Date</th>
            <th>No of package</th>
            <th>Returned Quantity(no’s/strip/Bottle/Sachet)</th>
            <th>Party Name</th>
            <th>Invoice no</th>
            <th>Reason for return</th>
            <th>Received by(WH)</th>
            <th>Done By</th>
            <th>Checked By</th>
            <th>Verified By</th>
            <th>Remark</th>
          </tr>
        </thead>
        <tbody>

          <% reportData.ReturnedFinishedRecords.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
              <td>
                <%= record?.unique_id || "Not Applicable" %>
              </td>
              <td>
                <%= formatDateOnly(record?.date) || "Not Applicable" %>
              </td>
              <td>
                <%= record?.product_name || "Not Applicable" %>
              </td>
              <td>
                <%= record?.batch_no || "Not Applicable" %>
              </td>
              <td>
                <%= record?.mfg_date || "Not Applicable" %>
              </td>
              <td>
                <%= record?.exp_date || "Not Applicable" %>
              </td>
              <td>
                <%= record?.no_of_package || "Not Applicable" %>
              </td>
              <td>
                <%= record?.returned_quantity || "Not Applicable" %>
              </td>
              <td>
                <%= record?.party_name || "Not Applicable" %>
              </td>
              <td>
                <%= record?.invoice_no || "Not Applicable" %>
              </td>
              <td>
                <%= record?.reason_for_return || "Not Applicable" %>
              </td>
              <td>
                <%= record?.received_by || "Not Applicable" %>
              </td>
               <td>
                  <%= record?.done_by || "Not Applicable" %>
                </td>
                <td>
                  <%= record?.reviewed_by || "Not Applicable" %>
                </td>
                 <td>
                <%= record?.verified_by || "Not Applicable" %>
              </td>
                <td>
                  <%= record?.remarks || "Not Applicable" %>
                </td>
             
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>

          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      Not Applicable
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

            <% } %>


</body>

</html>
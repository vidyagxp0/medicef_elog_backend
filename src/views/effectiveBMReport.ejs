<!DOCTYPE html>
<html>
<head>
   <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #000;
      margin: 25px;
      line-height: 1.6;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }
    h3.subheading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 14px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      /* border: 1px solid #000; */
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 8px;
      /* text-align: left; */
      font-size: 13px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: center;
      vertical-align: middle;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /*  DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }
  </style>
</head>

<body>

    <% 
const formatDateTime = (date) => {
  if (!date) return "Not Applicable";

  const d = new Date(date);

  const formatted = d.toLocaleString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });

  return formatted.replace(/\//g, "-");
};
 const formatDateOnly = (date) => {
        if (!date) return "Not Applicable";
        return new Date(date).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        }).replace(/\//g, "-");
        };
      


const record = reportData?.BreakdownMaintenanceRecords?.[0] || {};
  const parseSign = (val) => {
    try {
      return val ? JSON.parse(val) : null;
    } catch {
      return null;
    }
  };
  const userDeptSign = parseSign(record?.user_dept_sign_date);
  const receivedSign = parseSign(record?.request_received_sign);
  const completedSign = parseSign(record?.work_completed_sign);
  const qaSign = parseSign(record?.qa_sign_date);
  const acceptanceuserSign = parseSign(record?.acceptance_user_sign_date);
  const engCheckSign = parseSign(record?.checked_by_engineering_sign_date);
  const headEngSign = parseSign(record?.verified_by_head_engineering_sign_date);

  console.log("===== FIRST RECORD =====");
  console.log(record);
%>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/BMR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>
        </tr>
      </tbody>
    </table>

<!-- ================= RECORDS ================= -->
<h2 class="heading">Breakdown / Maintenance Work Order Records</h2>
<h3 class="subheading">Maintenance Work Request Details</h3>

<table class="details-table">
  <tbody>
    <tr>
      <td class="label">To</td>
      <td class="value">Engineering Department</td>
    </tr>
    <tr>
      <td class="label">From Department</td>
      <td class="value"><%= reportData?.departmentName || "Not Applicable" %></td>
    </tr>
    <tr>
      <td class="label">Requested By</td>
      <td class="value"><%= record?.requested_by || "Not Applicable" %></td>
    </tr>
    <tr>
      <td class="label">Date</td>
      <td class="value"><%= formatDateOnly(record?.request_date) || "Not Applicable" %></td>
    </tr>
    <tr>
      <td class="label">Time</td>
      <td class="value"><%= record?.request_time || "Not Applicable" %></td>
    </tr>
    <tr>
      <td class="label">Equipment / System / Area Name</td>
      <td class="value"><%= record?.equipment_system_area_name || "Not Applicable" %></td>
    </tr>
    <tr>
      <td class="label">Equipment / System / Area ID</td>
      <td class="value"><%= record?.area_id_no || "Not Applicable" %></td>
    </tr>
    <tr>
  <td class="label">Type of Work</td>
  <td class="value">
    Electrical: <%= record?.type_of_work_electrical ? "Yes" : "No" %><br>
    Mechanical: <%= record?.type_of_work_mechanical ? "Yes" : "No" %><br>
    Civil: <%= record?.type_of_work_civil ? "Yes" : "No" %><br>
    Other: <%= record?.type_of_work_other ? "Yes" : "No" %>
  </td>
</tr>

    <tr>
      <td class="label">Description of Job / Problem</td>
<td class="value"><%- record?.description_of_job || "Not Applicable" %></td>
</tr>

  <tr>
  <td class="label">User Department (Sign & Date)</td>
    <td class="value">
    <%= userDeptSign?.signed_by || "Not Signed" %>
    <% if (userDeptSign?.signed_at) { %>
      (<%= formatDateTime(userDeptSign.signed_at) %>)
    <% } %>
  </td>
</tr>
  </tbody>
</table>

<h3 class="subheading">Engineering Response</h3>

<table class="details-table">
  <tbody>
    <tr>
      <td class="label">Request Received By</td>
      <td class="value"><%= record?.request_received_by || "Not Applicable" %></td>
    </tr>
    <tr>
      <td class="label">Date</td>
      <td class="value"><%= formatDateOnly(record?.request_received_date) || "Not Applicable" %></td>
    </tr>
    <tr>
      <td class="label">Time</td>
      <td class="value"><%= record?.request_received_time || "Not Applicable" %></td>
    </tr>
     <tr>
  <td class="label">Sign</td>
<td class="value">
  <%= receivedSign?.signed_by || "Not Signed" %>
</td>
</tr>
<tr>
  <td class="label">
    Whether Change Control required for this work order?
  </td>
  <td class="value">
    <% if (record?.change_control_required === true) { %>
      Yes
    <% } else if (record?.change_control_required === false) { %>
      No
    <% } else { %>
      Not Applicable
    <% } %>
  </td>
</tr>

<% if (record?.change_control_required === true) { %>
<tr>
  <td class="label">Change Control No.</td>
  <td class="value">
    <%= record?.change_control_no || "Not Provided" %>
  </td>
</tr>
<% } %>

    <tr>
      <td class="label">Summary of Work Done</td>
<td class="value"><%- record?.summary_of_work_done || "Not Applicable" %></td>
    </tr>
   <tr>
      <td class="label">Work Completed by</td>
      <td class="value"><%= record?.work_completed_by || "Not Applicable" %></td>
    </tr>
    <tr>
      <td class="label">Date</td>
      <td class="value"><%= formatDateOnly(record?.work_completed_date) || "Not Applicable" %></td>
    </tr>
    <tr>
      <td class="label">Time</td>
      <td class="value"><%= record?.work_completed_time || "Not Applicable" %></td>
    </tr>
 <tr>
  <td class="label">Sign</td>
<td class="value">
  <%= completedSign?.signed_by || "Not Signed" %>
</td>
</tr>
  </tbody>
</table>

<h3 class="subheading">Quality Assurance Response</h3>

<table class="details-table">
  <tbody>
    <tr>
      <td class="label">Comment by QA Department</td>
<td class="value"><%- record?.qa_comments || "Not Applicable" %></td>
    </tr>
  <tr>
  <td class="label">
    Will this work affect the critical process?
  </td>
  <td class="value">
    <% if (record?.affects_critical_process === true) { %>
      Yes
    <% } else if (record?.affects_critical_process === false) { %>
      No
    <% } else { %>
      Not Applicable
    <% } %>
  </td>
</tr>

 <tr>
  <td class="label">QA Department (Sign & Date)</td>
  <td class="value">
    <%= qaSign?.signed_by || "Not Signed" %>
    <% if (qaSign?.signed_at) { %>
      (<%= formatDateTime(qaSign.signed_at) %>)
    <% } %>
  </td>

</tr>
  </tbody>
</table>
<h3 class="subheading">Acceptance Note</h3>

<table class="details-table">
  <tbody>
   <tr>
  <td class="label">
    Checked and verified that the Equipment / System / Area is available for routine use
  </td>
  <td class="value">
    <% if (record?.equipment_available_for_use === true) { %>
      Yes
    <% } else if (record?.equipment_available_for_use === false) { %>
      No
    <% } else { %>
      Not Applicable
    <% } %>
  </td>
</tr>

 <tr>
  <td class="label">User Department (Sign & Date)</td>
 <td class="value">
    <%= acceptanceuserSign?.signed_by || "Not Signed" %>
    <% if (acceptanceuserSign?.signed_at) { %>
      (<%= formatDateTime(acceptanceuserSign.signed_at) %>)
    <% } %>
  </td>

</tr>
  </tbody>
</table>

<h3 class="subheading">Checked & Verified By Engineering</h3>

<table class="details-table">
  <tbody>
  
 <tr>
  <td class="label">Checked By Engineering (Sign & Date)</td>
 <td class="value">
    <%= engCheckSign?.signed_by || "Not Signed" %>
    <% if (engCheckSign?.signed_at) { %>
      (<%= formatDateTime(engCheckSign.signed_at) %>)
    <% } %>
  </td>
</tr>
<tr>
  <td class="label">Verified By Head Engineering / Designee (Sign & Date)</td>
 <td class="value">
    <%= headEngSign?.signed_by || "Not Signed" %>
    <% if (headEngSign?.signed_at) { %>
      (<%= formatDateTime(headEngSign.signed_at) %>)
    <% } %>
  </td>
</tr>
  </tbody>
</table>



<!-- ================= ADDITIONAL ================= -->
<% if (reportData?.additionalAttachment || reportData?.additionalInfo) { %>
  <h2 class="heading">Additional</h2>
  <table>
    <tr>
      <th>Additional Attachment</th>
      <td>
        <% if (reportData?.additionalAttachment) { %>
          <a href="<%= reportData.additionalAttachment %>" target="_blank">View File</a>
        <% } else { %>
          Not Applicable
        <% } %>
      </td>
    </tr>
    <tr>
      <th>Additional Info</th>
      <td><%= reportData?.additionalInfo || "Not Applicable" %></td>
    </tr>
  </table>
<% } %>

</body>
</html>

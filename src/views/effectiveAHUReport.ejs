<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #000;
      margin: 25px;
      line-height: 1.6;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      /* border: 1px solid #000; */
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 8px;
      /* text-align: left; */
      font-size: 13px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: left;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /* 🔥 DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }
  </style>
</head>

<body>

  <% const formatDateOnly=(date)=> {
    if (!date) return "Not Applicable";
    return new Date(date).toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    });
    };
    %>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/AHU/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Air Handling Unit Records</h2>

    <% if (reportData.AhuOperationRecords && reportData.AhuOperationRecords.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th rowspan="2">S.No</th>
            <th rowspan="2">Unique ID</th>
            <th rowspan="2">Date</th>
            <th rowspan="2">Equipment ID</th>
            <th colspan="2" style="text-align: center;">Operation Status<br>ON/OFF</th>
          </tr>
          <tr>
            <th>Start Time</th>
            <th>Started By <br> (Sign/Date)</th>
          </tr>
        </thead>
        <tbody>

          <% reportData?.AhuOperationRecords?.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
              <td>
                <%= record?.unique_id || "Not Applicable" %>
              </td>
              <td>
                <%= formatDateOnly(record?.date) || "Not Applicable" %>
              </td>
              <td>
                <%= record?.equipmentId || "Not Applicable" %>
              </td>
              <td>
                <%= record?.startTime || "Not Applicable" %>
              </td>
              <td>
                <%= record?.startedBy || "Not Applicable" %>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>

    <% if (reportData.AhuOperationRecords && reportData.AhuOperationRecords.length> 0) { %>
      <table>
        <thead>
          <tr>
            <th rowspan="2">S.No</th>
            <th colspan="2" style="text-align: center;">Operation Status<br>ON/OFF</th>
            <th rowspan="2">Done By</th>
            <th rowspan="2">Reviewed By</th>
            <th rowspan="2">Remarks</th>
          </tr>
          <tr>
            <th>Stop Time</th>
            <th>Stopped By <br> (Sign/Date)</th>
          </tr>
        </thead>
        <tbody>

          <% reportData?.AhuOperationRecords?.forEach((record, index)=> { %>
            <tr>
              <td>
                <%= index + 1 %>
              </td>
              <td>
                <%= record?.stopTime || "Not Applicable" %>
              </td>
              <td>
                <%= record?.stoppedBy || "Not Applicable" %>
              </td>
              <td>
                <%= record?.done_by || "Not Applicable" %>
              </td>
              <td>
                <%= record?.reviewed_by || "Not Applicable" %>
              </td>
              <td>
                <%= record?.remarks || "Not Applicable" %>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>



          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      Not Applicable
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

            <% } %>


</body>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Effective Audit Report</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 12px;
      color: #000;
    }

    .page-wrap {
      width: 100%;
    }

    .report-title {
      text-align: center;
      font-size: 19px;
      font-weight: 700;
      margin: 20px 0;
      color: #000;
    }

    .report-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 12px;
    }

    .report-table th,
    .report-table td {
      border: 1px solid #42454a;
      padding: 6px 8px;
      text-align: left;
      font-size: 12px;
      vertical-align: top;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .report-table th {
      background-color: #f2f2f2;
      font-weight: bold;
    }

    .report-table td:first-child {
      text-align: center;
    }

    .performed-by {
      font-weight: bold;
    }

    .performed-on {
      font-size: 12px;
      color: #000;
    }

    .report-table tr {
      page-break-inside: avoid;
      page-break-after: auto;
    }

    .report-table thead {
      display: table-header-group;
    }

    .report-table tfoot {
      display: table-footer-group;
    }
    .signature-value {
  white-space: pre-line;
  line-height: 1.8;
}
  </style>
</head>

<body>
  
  <div class="page-wrap">

    <table class="report-table">
      <thead>
        <tr>
          <th style="width: 6%;">S. No.</th>
          <th style="width: 17%;">Field Name</th>
          <th style="width: 22%;">Previous Value</th>
          <th style="width: 22%;">New Value</th>
          <th style="width: 10%;">Status</th>
          <th style="width: 23%;">Performed By / On</th>
        </tr>
      </thead>

      <tbody>
        <%
            // Format date and datetime as DD-MM-YYYY HH:mm:ss
            const formatAuditDate = (value, includeTime = true) => {
              if (!value) return "NA";

              const str = String(value).trim();

              // Date only: YYYY-MM-DD
              const dateMatch = str.match(/^(\d{4})-(\d{2})-(\d{2})$/);

              if (dateMatch) {
                return `${dateMatch[3]}-${dateMatch[2]}-${dateMatch[1]}`;
              }

              // Time only: HH:mm:ss
              if (/^\d{2}:\d{2}(:\d{2})?$/.test(str)) {
                return str;
              }

              const date = new Date(value);

              if (isNaN(date.getTime())) return str;

              const day = String(date.getDate()).padStart(2, "0");
              const month = String(date.getMonth() + 1).padStart(2, "0");
              const year = date.getFullYear();

              if (!includeTime) {
                return `${day}-${month}-${year}`;
              }

              const hours = String(date.getHours()).padStart(2, "0");
              const minutes = String(date.getMinutes()).padStart(2, "0");
              const seconds = String(date.getSeconds()).padStart(2, "0");

              return `${day}-${month}-${year} ${hours}:${minutes}:${seconds}`;
            };


            // Convert HTML rich text into plain text
            const stripHtml = (value) => {
              if (value === null || value === undefined) return "NA";

              return String(value)
                .replace(/<br\s*\/?>/gi, " ")
                .replace(/<\/p>/gi, " ")
                .replace(/<\/div>/gi, " ")
                .replace(/<[^>]*>/g, "")
                .replace(/&nbsp;/gi, " ")
                .replace(/&amp;/gi, "&")
                .replace(/&lt;/gi, "<")
                .replace(/&gt;/gi, ">")
                .replace(/&quot;/gi, '"')
                .replace(/&#39;/gi, "'")
                .replace(/\s+/g, " ")
                .trim();
            };


            // Format audit values including E-sign
            const formatAuditValue = (value, fieldName = "") => {
              if (value === null || value === undefined || value === "") {
                return "NA";
              }

              let parsed = value;

              // Parse JSON signature
              if (typeof value === "string") {
                try {
                  parsed = JSON.parse(value);
                } catch {
                  parsed = value;
                }
              }

              // E-signature handling
              if (
                typeof parsed === "object" &&
                parsed !== null &&
                parsed.signed !== undefined &&
                parsed.signed_by !== undefined
              ) {
                 return parsed.signed
                ? `Status: Signed ✓\nSigned By: ${parsed.signed_by}\nSigned At: ${formatAuditDate(parsed.signed_at)}`
                : "Status: Not Signed";
            }

              // Other JSON objects
              if (typeof parsed === "object") {
                return JSON.stringify(parsed);
              }

              // Boolean handling
              if (parsed === true || parsed === "true") return "Yes";
              if (parsed === false || parsed === "false") return "No";

              // Date field handling
              if (/date/i.test(fieldName)) {
                return formatAuditDate(parsed, false);
              }

              // Remove HTML
              return stripHtml(parsed);
            };
          %>
        <% if (reportData.auditTrail && reportData.auditTrail.length > 0) { %>

          <% reportData.auditTrail.forEach((record) => { %>
            <tr>
              <td><%= record.serialNo %></td>
              <td><%= stripHtml(record.field_name) %></td>
              <td class="signature-value"><%= formatAuditValue(record.previous_value, record.field_name) %></td>
              <td class="signature-value"><%= formatAuditValue(record.new_value, record.field_name) %></td>
              <td><%= record.status %></td>

              <td>
                <div class="performed-on"><b>Performed By:</b>
                   <%= record.performedBy || "NA" %>
                </div>

                <div class="performed-on">
                  <b>Performed On:</b>
                    <%= record?.performed_at
                      ? new Date(record.performed_at).toLocaleDateString('en-GB', {
                          day: '2-digit',
                          month: 'short',
                          year: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit',
                          second: '2-digit',
                          hourCycle: 'h23',
                          timeZone: 'Asia/Kolkata'
                        })
                      : 'N/A'
                    %>
                </div>
              </td>
            </tr>
          <% }) %>

        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center;">
              No audit records found
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>

  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Effective Audit Report</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 12px;
      color: #000;
    }

    .page-wrap {
      width: 100%;
    }

    .report-title {
      text-align: center;
      font-size: 19px;
      font-weight: 700;
      margin: 20px 0;
      color: #000;
    }

    .report-table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      font-size: 12px;
    }

    .report-table th,
    .report-table td {
      border: 1px solid #42454a;
      padding: 6px 8px;
      text-align: left;
      font-size: 12px;
      vertical-align: top;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }

    .report-table th {
      background-color: #f2f2f2;
      font-weight: bold;
    }

    .report-table td:first-child {
      text-align: center;
    }

    .performed-by {
      font-weight: bold;
    }

    .performed-on {
      font-size: 12px;
      color: #000;
    }

    .report-table tr {
      page-break-inside: avoid;
      page-break-after: auto;
    }

    .report-table thead {
      display: table-header-group;
    }

    .report-table tfoot {
      display: table-footer-group;
    }
  </style>
</head>

<body>
  <div class="page-wrap">

    <table class="report-table">
      <thead>
        <tr>
          <th style="width: 6%;">S. No.</th>
          <th style="width: 17%;">Field Name</th>
          <th style="width: 22%;">Previous Value</th>
          <th style="width: 22%;">New Value</th>
          <th style="width: 10%;">Status</th>
          <th style="width: 23%;">Performed By / On</th>
        </tr>
      </thead>

      <tbody>
        <% if (reportData.auditTrail && reportData.auditTrail.length > 0) { %>

          <% reportData.auditTrail.forEach((record) => { %>
            <tr>
              <td><%= record.serialNo %></td>
              <td><%= record.field_name %></td>
              <td><%= record.previous_value %></td>
              <td><%= record.new_value %></td>
              <td><%= record.status %></td>

              <td>
                <div class="performed-on"><b>Performed By:</b>
                  <%= record.performedBy %>
                </div>

                <div class="performed-on">
                  <b>Performed On:</b>
                  <%= record.performedOn %>
                </div>
              </td>
            </tr>
          <% }) %>

        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center;">
              No audit records found
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>

  </div>
</body>
</html>

<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 12px;
      color: #000;
      margin: 25px;
      line-height: 1.35;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      /* border: 1px solid #000; */
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 5px;
      /* text-align: left; */
      font-size: 11px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: left;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /* 🔥 DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }

    h1 {
      font-size: 18px;
    }

    h2.heading {
      font-size: 13.5px;
      padding: 5px 8px;
    }    
  </style>
</head>

<body>

    <% const formatDateTime=(date)=> {
        if (!date) return "Not Applicable";
        return new Date(date).toLocaleString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
        }).replace(/\//g, "-");
        };

        const formatDateOnly = (date) => {
        if (!date) return "Not Applicable";
        return new Date(date).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        }).replace(/\//g, "-");
        };
        %>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
            <tr>
                <td class="label">Record Id</td>
                <td class="value">
                    MED/MCR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
                </td>
            </tr>
            <tr>
                <td class="label">Initiator name</td>
                <td class="value">
                    <%= reportData?.initiator_name || "Not Applicable" %>
                </td>
            </tr>
            <tr>
                <td class="label">Initiation Date</td>
                <td class="value">
                    <%= formatDateTime(reportData?.date_of_initiation) %>
                </td>
            </tr>
            <tr>
                <td class="label">Area Name</td>
                <td class="value">
                    <%= reportData?.area_name || "Not Applicable" %>
                </td>
            </tr>
            <tr>
                <td class="label">Room Id</td>
                <td class="value">
                    <%= reportData?.room_id || "Not Applicable" %>
                </td>
            </tr>
            <!-- <tr>
                <td class="label">Instrument Id</td>
                <td class="value">
                    <%= reportData?.instrumentID || "Not Applicable" %>
                </td>
            </tr> -->
            <tr>
                <td class="label">Department</td>
                <td class="value">
                    <%= reportData?.departmentName || "Not Applicable" %>
                </td>
            </tr>
             <tr>
                <td class="label">Name of Media</td>
                <td class="value">
                    <%= reportData?.nameOfMedia || "Not Applicable" %>
                </td>
             </tr>
             <tr>
                <td class="label">Make</td>
                <td class="value">
                    <%= reportData?.make || "Not Applicable" %>
                </td>
             </tr>
                <tr>
                    <td class="label">Manufacturing Date</td>
                    <td class="value">
                        <%= formatDateOnly(reportData?.manufacturingDate) || "Not Applicable" %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Expiry Date</td>
                    <td class="value">
                        <%= formatDateOnly(reportData?.expiryDate) || "Not Applicable" %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Batch No</td>
                    <td class="value">
                        <%= reportData?.batchNo || "Not Applicable" %>
                    </td>
                </tr>
                <tr> 
                    <td class="label">Date of Receipt</td>
                    <td class="value">
                        <%= formatDateOnly(reportData?.dateOfReceipt) || "Not Applicable" %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Quantity Received</td>
                    <td class="value">
                        <%= reportData?.quantityReceived || "Not Applicable" %>
                    </td>
                    </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Media Consumption Records</h2>

<% if (reportData.mediaConsumptionRecords && reportData.mediaConsumptionRecords.length > 0) { %>
<table>
  <thead>
    <tr>
      <th >S.No</th>
      <th >Unique ID</th>
      <th >Date of Use</th>
      <th >Container No.</th>
      <th >Media Quantity (g)</th>
      <th >Media Quantity withdrawn (g)</th>
      <th >Media Balance Quantity (g)</th>
      <th >Autoclave Media Lot No.</th>
      <th >Done by</th>
      <th >Checked By</th>
      <th >Remarks</th>
    </tr>
    <tr>

    </tr>
  </thead>

  <tbody>
    <% reportData.mediaConsumptionRecords.forEach((record, index) => { %>
    <tr>
      <td><%= index + 1 %></td>
      <td><%= record?.unique_id || "Not Applicable" %></td>
      <td><%= formatDateOnly(record?.dateOfUse) || "Not Applicable" %></td>
      <td><%= record?.containerNo || "Not Applicable" %></td>
      <td><%= record?.mediaQty || "Not Applicable" %></td>
      <td><%= record?.mediaQtyWithdrawn || "Not Applicable" %></td>
      <td><%= record?.mediaBalanceQty || "Not Applicable" %></td>
      <td><%= record?.autoclaveMedia || "Not Applicable" %></td>
      <td><%= record?.done_by || "Not Applicable" %></td>
      <td><%= record?.reviewed_by || "Not Applicable" %></td>
      <td><%= record?.remarks || "Not Applicable" %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } else { %>
<p>No Records Found.</p>
<% } %>



          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      Not Applicable
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

            <% } %>


</body>

</html>
<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 12px;
      color: #000;
      margin: 25px;
      line-height: 1.35;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }

    th, td {
      border: 1px solid #ccc;
      min-width: 20px;
      padding: 5px;
      text-align: center;
      vertical-align: middle;
    }

    th {
      background: #f3f4f6;
      font-weight: 600;
    }

    .status-yes {
      color: #16a34a;
      font-weight: bold;
      font-size: 16px;
      display: block;
    }

    .status-no {
      color: #dc2626;
      font-weight: bold;
      font-size: 16px;
      display: block;
    }

    .cell-meta {
      font-size: 9.5px;
      color: #374151;
      margin-top: 2px;
      word-break: break-word;
    }

    .sub-row {
      padding-left: 16px;
      font-style: italic;
      background: #fafafa;
      text-align: left;
    }

    .heading {
      margin: 16px 0 8px;
      font-size: 14px;
      font-weight: bold;
    }

    .details-table td {
      padding: 6px 8px;
      text-align: left;
    }

    .label {
      font-weight: 600;
      width: 180px;
      background: #f9fafb;
    }
      .black {
      color: black;
    }

    h1 {
      font-size: 18px;
    }

    h2.heading {
      font-size: 13.5px;
      padding: 5px 8px;
    }  
    .row-label {
  font-size: 11px;
  font-weight: 500;
  text-align: center;
}
 
.icon {
  font-size: 12px;
  font-weight: bold;
  line-height: 1;
  text-align: center;
  vertical-align: middle;

}

.icon-yes {
  color: #16a34a; /* green */
}

.icon-no {
  color: #dc2626; /* red */
}

.icon-muted {
  color: #9ca3af; /* grey */
}
  </style>
</head>
<body>

    <% 
const formatDateTime = (date) => {
  if (!date) return "Not Applicable";

  const d = new Date(date);

  const formatted = d.toLocaleString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: true   
  });

  return formatted.replace(/\//g, "-");
};

reportData.DrainCleaningRecords.forEach(r => {
  if (r.role === "reviewer" || r.role === "approver") {
    console.log("CHECK ROW DATA:", {
      row_id: r.row_id,
      role: r.role,
      day: r.day,
      by: r.by
    });
  }
});
%>


    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/DCR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Drain cleaning and sanitization Records</h2>

    <% if (reportData.DrainCleaningRecords && reportData.DrainCleaningRecords.length> 0) { %>

<table>
  <thead>
    <tr>
      <th style="min-width:16px;">Date</th>
      <% DAYS.forEach(day => { %>
        <th><%= day %></th>
      <% }) %>
    </tr>
  </thead>

<tbody>
  <% rows.forEach(row => { %>
    <tr>

      <!-- ROW LABEL -->
      <td class="row-label">
      <%= row.sub ? '' : row.label %></td>

      <% DAYS.forEach(day => { 
           const cell = grid[row.id]?.[day];
           const isReviewerRow = row.id === 16;
           const isApproverRow = row.id === 17;
      %>

      <td>
      <% if (cell) { %>

    <% if (row.id === 16 || row.id === 17) { %>
      <!-- Reviewer / Approver → ONLY NAME -->
      <% if (cell.by) { %>
        <div class="cell-meta"><%= cell.by %></div>
      <% } %>

    <% } else { %>
      <!-- Other rows → ONLY ACTIVE ICON -->

      <% if (cell.status === 'checked') { %>
        <span class="icon icon-yes">✔</span>
      <% } else if (cell.status === 'cross') { %>
        <span class="icon icon-no">✖</span>
      <% } %>

    <% } %>

  <% } %>
</td>

      <% }) %>
    </tr>
  <% }) %>
</tbody>
</table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>

  
          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      Not Applicable
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

            <% } %>


</body>

</html>
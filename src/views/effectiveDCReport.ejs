<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 11.5px;
      color: #000;
      margin: 0;
      padding: 0;
      line-height: 1.35;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 4px 10px;
      font-size: 12.5px;
      background-color: #e9ecef;
      margin: 8px 0 5px 0;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
      font-size: 9.5px;
    }

    th, td {
      border: 1px solid #ccc;
      padding: 4px 1px;
      text-align: center;
      vertical-align: middle;
      box-sizing: border-box;
      overflow: hidden;
    }

    th {
      background: #f3f4f6;
      font-weight: 600;
    }

    .details-table {
      margin-bottom: 8px;
    }

    .details-table td {
      padding: 5px 8px;
      text-align: left;
      font-size: 10.5px;
    }

    .details-table td.label {
      font-weight: 600;
      background: #f9fafb;
      width: 12%;
    }

    .details-table td.value {
      width: 21.33%;
    }

    .row-label {
      font-size: 9.5px;
      font-weight: 500;
      text-align: left;
      padding-left: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .row-label.indented {
      padding-left: 12px;
    }

    .icon {
      font-size: 10px;
      font-weight: bold;
      line-height: 1;
      text-align: center;
      vertical-align: middle;
    }

    .icon-yes {
      color: #16a34a;
    }

    .icon-no {
      color: #dc2626;
    }

    .icon-muted {
      color: #9ca3af;
    }
  </style>
</head>
<body>

<% 
const formatDateTime = (date) => {
  if (!date) return "Not Applicable";
  const d = new Date(date);
  const formatted = d.toLocaleString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: true   
  });
  return formatted.replace(/\//g, "-");
};

const formatTime24 = (dateStr) => {
  if (!dateStr) return "";
  if (typeof dateStr === "string") {
    const trimmed = dateStr.trim();
    const parts = trimmed.split(":");
    if (parts.length >= 2) {
      return `${parts[0].padStart(2, "0")}:${parts[1].padStart(2, "0")}`;
    }
  }
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  const hh = String(d.getHours()).padStart(2, "0");
  const mm = String(d.getMinutes()).padStart(2, "0");
  return `${hh}:${mm}`;
};

const formatMonthYear = (dateStr) => {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  return `${months[d.getMonth()]} ${d.getFullYear()}`;
};
%>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record ID</td>
          <td class="value">
            MED/DCR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "Not Applicable" %>
          </td>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>
          <td class="label">Fiscal Year</td>
          <td class="value">
            <%= reportData?.fiscal_year || "Not Applicable" %>
          </td>
          <td class="label">Month</td>
          <td class="value">
            <%= reportData?.month_display || (reportData?.date_of_initiation ? formatMonthYear(reportData.date_of_initiation) : "Not Applicable") %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading" style="margin-top: 18px;">Drain cleaning and sanitization Records</h2>

    <% if (reportData.DrainCleaningRecords && reportData.DrainCleaningRecords.length > 0) { %>

<table style="width: 100%; table-layout: fixed; border-collapse: collapse;">
  <colgroup>
    <col style="width: 110px;" />
    <% DAYS.forEach(() => { %>
      <col />
    <% }) %>
  </colgroup>
  <thead>
    <% 
      const totalCols = 1 + DAYS.length;
      const col1 = Math.floor(totalCols / 4);
      const col2 = Math.floor(totalCols / 4);
      const col3 = Math.floor(totalCols / 4);
      const col4 = totalCols - (col1 + col2 + col3);
    %>
    <tr>
      <td colspan="<%= col1 %>" style="text-align: left; font-weight: bold; background: #fff; border: 1px solid #ccc; padding: 4px 6px; font-size: 9.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
        DEPARTMENT: <%= reportData?.departmentName || "Not Applicable" %>
      </td>
      <td colspan="<%= col2 %>" style="text-align: left; font-weight: bold; background: #fff; border: 1px solid #ccc; padding: 4px 6px; font-size: 9.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
        AREA: <%= reportData?.area_name || "Not Applicable" %>
      </td>
      <td colspan="<%= col3 %>" style="text-align: left; font-weight: bold; background: #fff; border: 1px solid #ccc; padding: 4px 6px; font-size: 9.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
        FISCAL YEAR: <%= reportData?.fiscal_year || "Not Applicable" %>
      </td>
      <td colspan="<%= col4 %>" style="text-align: left; font-weight: bold; background: #fff; border: 1px solid #ccc; padding: 4px 6px; font-size: 9.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
        MONTH: <%= reportData?.month_display || (reportData?.date_of_initiation ? formatMonthYear(reportData.date_of_initiation) : "Not Applicable") %>
      </td>
    </tr>
    <tr>
      <th style="text-align: left; padding: 4px 6px; font-size: 9px; box-sizing: border-box;">Date &nbsp;→</th>
      <% DAYS.forEach(day => { %>
        <th style="font-size: 8.5px; padding: 4px 1px;"><%= day %></th>
      <% }) %>
    </tr>
  </thead>

<tbody>
  <% rows.forEach(row => { %>
    <tr>

      <!-- ROW LABEL -->
      <td class="row-label <%= (row.id >= 6 && row.id <= 15) ? 'indented' : '' %>">
        <%= row.label %>
      </td>

      <% if (row.id === 5) { %>
        <!-- Drain ID header row → Merge all day columns into one empty cell -->
        <td colspan="<%= DAYS.length %>" style="background: #f9fafb;"></td>
      <% } else { %>
        <% DAYS.forEach(day => { 
             const cell = grid[row.id]?.[day];
        %>

        <td>
        <% if (cell) { %>

          <% if (row.id === 16 || row.id === 17) { %>
            <!-- Checked By / Verified By → Sign + Date -->
            <% if (cell.by) { %>
              <div style="font-size: 7px; line-height: 1.15; word-break: break-word; text-align: center; color: #000;">
                <span style="font-weight: 600;"><%= cell.by %></span>
                <% if (cell.time) { 
                     const dt = new Date(cell.time);
                     if (!isNaN(dt.getTime())) {
                       const dStr = `${String(dt.getDate()).padStart(2, '0')}/${String(dt.getMonth()+1).padStart(2, '0')}`;
                %>
                  <div style="font-size: 6px; color: #555; margin-top: 1px;"><%= dStr %></div>
                <%   } 
                   } %>
              </div>
            <% } %>

          <% } else if (row.id === 1) { %>
            <!-- Time row -->
            <% const formattedT = formatTime24(cell.time); %>
            <% if (formattedT) { %>
              <span class="icon icon-yes" style="font-size: 8px; font-weight: 600; white-space: nowrap;"><%= formattedT %></span>
            <% } %>

          <% } else if (row.id === 2) { %>
            <!-- Cleaning Agent -->
            <% if (cell.status === 'T') { %>
              <span class="icon icon-yes" style="font-weight: bold; font-size: 10px;">T</span>
            <% } else if (cell.status === 'NA') { %>
              <span class="icon icon-muted" style="font-weight: bold; font-size: 8.5px;">NA</span>
            <% } %>

          <% } else if (row.id === 3) { %>
            <!-- Disinfectant Used -->
            <% if (cell.status === 'D') { %>
              <span class="icon icon-yes" style="font-weight: bold; font-size: 10px;">D</span>
            <% } else if (cell.status === 'S') { %>
              <span class="icon icon-yes" style="font-weight: bold; font-size: 10px;">S</span>
            <% } else if (cell.status === 'NA') { %>
              <span class="icon icon-muted" style="font-weight: bold; font-size: 8.5px;">NA</span>
            <% } %>

          <% } else if (row.id === 4) { %>
            <!-- Sanitizer Used -->
            <% if (cell.status === 'SHC') { %>
              <span class="icon icon-yes" style="font-size: 8.5px; font-weight: bold;">SHC</span>
            <% } else if (cell.status === 'NA') { %>
              <span class="icon icon-muted" style="font-weight: bold; font-size: 8.5px;">NA</span>
            <% } %>

          <% } else if (row.id !== 1 && row.id !== 2 && row.id !== 3 && row.id !== 4 && row.id !== 5 && row.id !== 16 && row.id !== 17) { %>
            <!-- Drain ID rows -->
            <% if (cell.status === '√' || cell.status === 'check' || cell.checked === true) { %>
              <span class="icon icon-yes" style="font-size: 11.5px;">✓</span>
            <% } else if (cell.status === 'NA') { %>
              <span class="icon icon-muted" style="font-weight: bold; font-size: 8.5px;">NA</span>
            <% } %>

          <% } else { %>
            <!-- Standard check/cross fallback -->
            <% if (cell.status === 'checked' || cell.status === 'true' || cell.status === true) { %>
              <span class="icon icon-yes">✔</span>
            <% } else if (cell.status === 'cross' || cell.status === 'false' || cell.status === false) { %>
              <span class="icon icon-no">✖</span>
            <% } %>
          <% } %>

        <% } %>
        </td>

        <% }) %>
      <% } %>
    </tr>
  <% }) %>
</tbody>
</table>
      <% } else { %>
        <p style="padding: 10px; color: #555;">No Records Found.</p>
        <% } %>

  
          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th style="width: 20%; text-align: left; padding: 5px 6px;">Additional Attachment</th>
                <td style="text-align: left; padding: 5px 6px;">
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                  <% } else { %>
                    Not Applicable
                  <% } %>
                </td>
              </tr>

              <tr>
                <th style="text-align: left; padding: 5px 6px;">Additional Info</th>
                <td style="text-align: left; padding: 5px 6px;">
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

          <% } %>

    <!-- ================= INSTRUCTIONS & FREQUENCIES ================= -->
    <h2 class="heading" style="margin-top: 18px;">Instructions & Frequencies</h2>
    <div style="padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 4px; background-color: #f8fafc; font-size: 9.5px; line-height: 1.5; color: #334155; margin-bottom: 6px; page-break-inside: avoid;">
      <p style="margin: 0 0 5px 0;">
        <strong>Note:</strong> 0.1% V/V Teepol solution used as cleaning agent denoted by <strong>"T"</strong>, 2.5% V/V Dettol/Savlon solution used as disinfectant denoted by <strong>"D"</strong> or <strong>"S"</strong> respectively, 4% Sod. Hypochloride V/V solution used as sanitizer denoted as <strong>"SHC"</strong>. Drain cleaned should be marked by <strong>"✓"</strong> and <strong>"NA"</strong> for not applicable.
      </p>
      <p style="margin: 0;">
        <strong>Frequency:</strong> Drains should be cleaned at the end of last working shift of the day, disinfectant solution used alternately every week and sanitization of drains should be done at the end of the last working shift of the week.
      </p>
    </div>

</body>
</html>
<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 12px;
      color: #000;
      margin: 25px;
      line-height: 1.35;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 25px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
      font-size: 10px;
    }

    th, td {
      border: 1px solid #ccc;
      padding: 3px 1px;
      text-align: center;
      vertical-align: middle;
      box-sizing: border-box;
      overflow: hidden;
    }

    th {
      background: #f3f4f6;
      font-weight: 600;
    }

    .status-yes {
      color: #16a34a;
      font-weight: bold;
      font-size: 16px;
      display: block;
    }

    .status-no {
      color: #dc2626;
      font-weight: bold;
      font-size: 16px;
      display: block;
    }

    .cell-meta {
      font-size: 9.5px;
      color: #374151;
      margin-top: 2px;
      word-break: break-word;
    }

    .sub-row {
      padding-left: 16px;
      font-style: italic;
      background: #fafafa;
      text-align: left;
    }

    .heading {
      margin: 16px 0 8px;
      font-size: 14px;
      font-weight: bold;
    }

    .details-table td {
      padding: 6px 8px;
      text-align: left;
    }

    .label {
      font-weight: 600;
      width: 180px;
      background: #f9fafb;
    }
      .black {
      color: black;
    }

    h1 {
      font-size: 18px;
    }

    h2.heading {
      font-size: 13.5px;
      padding: 5px 8px;
    }  
    .row-label {
      font-size: 10px;
      font-weight: 500;
      text-align: left;
      padding-left: 8px;
    }
 
.icon {
  font-size: 10px;
  font-weight: bold;
  line-height: 1;
  text-align: center;
  vertical-align: middle;
}

.icon-yes {
  color: #16a34a; /* green */
}

.icon-no {
  color: #dc2626; /* red */
}

.icon-muted {
  color: #9ca3af; /* grey */
}
  </style>
</head>
<body>

    <% 
const formatDateTime = (date) => {
  if (!date) return "Not Applicable";

  const d = new Date(date);

  const formatted = d.toLocaleString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: true   
  });

  return formatted.replace(/\//g, "-");
};

const formatTime24 = (dateStr) => {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  const hh = String(d.getHours()).padStart(2, "0");
  const mm = String(d.getMinutes()).padStart(2, "0");
  return `${hh}:${mm}`;
};

const formatMonthYear = (dateStr) => {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  return `${months[d.getMonth()]} ${d.getFullYear()}`;
};
%>


    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/DCR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "Not Applicable" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "Not Applicable" %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Drain cleaning and sanitization Records</h2>

    <% if (reportData.DrainCleaningRecords && reportData.DrainCleaningRecords.length> 0) { %>

<table style="width: 100%; table-layout: fixed; border-collapse: collapse;">
  <colgroup>
    <col style="width: 90px;" />
    <% DAYS.forEach(() => { %>
      <col style="width: 25px;" />
    <% }) %>
  </colgroup>
  <thead>
    <tr>
      <td colspan="11" style="text-align: left; font-weight: bold; background: #fff; border: 1px solid #ccc; padding: 6px; font-size: 10px;">
        DEPARTMENT: <%= reportData?.departmentName || "Not Applicable" %>
      </td>
      <td colspan="10" style="text-align: left; font-weight: bold; background: #fff; border: 1px solid #ccc; padding: 6px; font-size: 10px;">
        AREA: <%= reportData?.area_name || "Not Applicable" %>
      </td>
      <td colspan="11" style="text-align: left; font-weight: bold; background: #fff; border: 1px solid #ccc; padding: 6px; font-size: 10px;">
        MONTH & YEAR: <%= reportData?.date_of_initiation ? formatMonthYear(reportData.date_of_initiation) : "Not Applicable" %>
      </td>
    </tr>
    <tr>
      <th style="text-align: left; padding: 4px 6px; font-size: 9px; box-sizing: border-box;">Date &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; →</th>
      <% DAYS.forEach(day => { %>
        <th><%= day %></th>
      <% }) %>
    </tr>
  </thead>

<tbody>
  <% rows.forEach(row => { %>
    <tr>

      <!-- ROW LABEL -->
      <td class="row-label">
      <%= (row.sub && !row.showLabel) ? '' : row.label %></td>

      <% if (row.id === 5) { %>
        <!-- Drain ID header row → Merge 31 columns into one empty cell -->
        <td colspan="31" style="background: #f9fafb;"></td>
      <% } else { %>
        <% DAYS.forEach(day => { 
             const cell = grid[row.id]?.[day];
             const isReviewerRow = row.id === 16;
             const isApproverRow = row.id === 17;
        %>

        <td>
        <% if (cell) { %>

      <% if (row.id === 16 || row.id === 17) { %>
        <!-- Reviewer / Approver → ONLY NAME -->
        <% if (cell.by) { %>
          <div class="cell-meta"><%= cell.by %></div>
        <% } %>

      <% } else { %>
        <!-- Other rows → Custom layout per row type -->
        <% if (row.id === 1) { %>
          <!-- Time row -->
          <% if (cell.status === 'checked') { %>
            <span class="icon icon-yes" style="font-size: 10px;"><%= formatTime24(cell.time) %></span>
          <% } else if (cell.status === 'cross') { %>
            <span class="icon icon-no" style="font-size: 10px;"><%= formatTime24(cell.time) %></span>
          <% } %>

        <% } else if (row.id === 2) { %>
          <!-- Cleaning Agent -->
          <% if (cell.status === 'T') { %>
            <span class="icon icon-yes">T</span>
          <% } else if (cell.status === 'NA') { %>
            <span class="icon icon-muted">NA</span>
          <% } %>

        <% } else if (row.id === 3) { %>
          <!-- Disinfectant Used -->
          <% if (cell.status === 'D') { %>
            <span class="icon icon-yes">D</span>
          <% } else if (cell.status === 'S') { %>
            <span class="icon icon-yes">S</span>
          <% } else if (cell.status === 'NA') { %>
            <span class="icon icon-muted">NA</span>
          <% } %>

        <% } else if (row.id === 4) { %>
          <!-- Sanitizer Used -->
          <% if (cell.status === 'SHC') { %>
            <span class="icon icon-yes">SHC</span>
          <% } else if (cell.status === 'NA') { %>
            <span class="icon icon-muted">NA</span>
          <% } %>

        <% } else if (row.id >= 6 && row.id <= 15) { %>
          <!-- Drain ID rows -->
          <% if (cell.status === '√') { %>
            <span class="icon icon-yes">√</span>
          <% } else if (cell.status === 'NA') { %>
            <span class="icon icon-muted">NA</span>
          <% } %>

        <% } else { %>
          <!-- Standard check/cross fallback -->
          <% if (cell.status === 'checked' || cell.status === 'true' || cell.status === true) { %>
            <span class="icon icon-yes">✔</span>
          <% } else if (cell.status === 'cross' || cell.status === 'false' || cell.status === false) { %>
            <span class="icon icon-no">✖</span>
          <% } %>
        <% } %>

      <% } %>

    <% } %>
  </td>

        <% }) %>
      <% } %>
    </tr>
  <% }) %>
</tbody>
</table>
      <% } else { %>
        <p>No Records Found.</p>
        <% } %>

  
          <!-- ================= ADDITIONAL ================= -->
          <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

            <h2 class="heading">Additional</h2>
            <table>
              <tr>
                <th>Additional Attachment</th>
                <td>
                  <% if (reportData?.additionalAttachment) { %>
                    <a href="<%= reportData.additionalAttachment %>" target="_blank">
                      View File
                    </a>
                    <% } else { %>
                      Not Applicable
                      <% } %>
                </td>
              </tr>

              <tr>
                <th>Additional Info</th>
                <td>
                  <%= reportData?.additionalInfo || "Not Applicable" %>
                </td>
              </tr>
            </table>

            <% } %>

    <!-- ================= INSTRUCTIONS ================= -->
    <h2 class="heading">Instructions & Frequencies</h2>
    <div style="padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; background-color: #f8fafc; font-size: 11px; line-height: 1.5; color: #334155; margin-bottom: 20px; page-break-inside: avoid;">
      <p style="margin: 0 0 6px 0;">
        <strong>Note:</strong> 0.1% V/V Teepol solution used as cleaning agent denoted by <strong>"T"</strong>, 2.5% V/V Dettol/Savlon solution used as disinfectant denoted by <strong>"D"</strong> or <strong>"S"</strong> respectively, 4% Sod. Hypochloride V/V solution used as sanitizer denoted as <strong>"SHC"</strong>. Drain cleaned should be marked by <strong>"√"</strong> and <strong>"NA"</strong> for not applicable.
      </p>
      <p style="margin: 0;">
        <strong>Frequency:</strong> Drains should be cleaned at the end of last working shift of the day, disinfectant solution used alternately every week and sanitization of drains should be done at the end of the last working shift of the week.
      </p>
    </div>

</body>

</html>
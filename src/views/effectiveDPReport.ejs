<!DOCTYPE html>
<html>
<head>
  <style>
    body {
        font-family: Arial, sans-serif;
        font-size: 14px;
        margin: 20px;
        line-height: 1.6;
    }

    h2.heading {
        padding-top: 0px;
        font-size: 18px;
        color: #0066CC;
        margin-bottom: 15px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 25px;
        border: 1px solid #000;
        page-break-inside: auto;
    }

    th, td {
        border: 1px solid #000;
        padding: 8px;
        text-align: left;
        font-size: 13px;
    }

    th {
        background: #f8f8f8;
        font-weight: bold;
    }

    thead {
        display: table-header-group; /* 🔥 PRINT PAR HEADER AUTO REPEAT */
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto;
    }

    .green { color: green; font-weight: bold; }
    .red { color: red; font-weight: bold; }
    .black { color: black; font-weight: bold; }
  </style>
</head>

<body>

  <h2 class="heading">Differential Pressure Records</h2>

  <div style="margin-bottom: 10px;">
    <strong style="font-size: medium;">Limit:</strong>
    <span><%= reportData?.limit %></span>
  </div>

  <% if (reportData.DifferentialPressureRecords && reportData.DifferentialPressureRecords.length > 0) { %>

  <!-- 🔥 Table only once — rows dynamically inside -->
  <table>
    <thead>
      <tr>
        <th>S.No</th>
        <th>Unique ID</th>
        <th>Date</th>
        <th>Time</th>
        <th>Differential Pressure</th>
        <th>Done by</th>
        <th>Checked By</th>
        <th>Supporting Docs</th>
        <th>Remark</th>
      </tr>
    </thead>

    <tbody>
      <% reportData.DifferentialPressureRecords.forEach((record, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= record?.unique_id || "Not Applicable" %></td>
          <td><%= record?.date || "Not Applicable" %></td>
          <td><%= record?.time || "Not Applicable" %></td>

          <td class="<%= 
                record?.differential_pressure < reportData?.limit 
                    ? 'green' 
                    : record?.differential_pressure > reportData?.limit 
                        ? 'red' 
                        : 'black' 
            %>">
            <%= record?.differential_pressure || "Not Applicable" %>
          </td>

          <td><%= record?.done_by || "Not Applicable" %></td>
          <td><%= record?.reviewed_by || "Not Applicable" %></td>
          <td>
              <% if (record?.supporting_docs) { %>
              <a href="<%= record.supporting_docs %>" target="_blank">View File</a>
              <% } else { %>
              Not Applicable
              <% } %>
          </td>
          
          <td><%= record?.remarks || "Not Applicable" %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% } else { %>
    <p>No Records Found.</p>
  <% } %>

  <h2 class="heading">Additional</h2>
  <table>
    <tr>
      <th>Additional Attachment</th>
      <td>
        <% if (reportData?.additionalAttachment) { %>
            <a href="<%= reportData.additionalAttachment %>" target="_blank">View File</a>
        <% } else { %>
            Not Applicable
        <% } %>
      </td>
    </tr>

    <tr>
      <th>Addtional Info</th>
      <td><%= reportData?.additionalInfo || "Not Applicable" %></td>
    </tr>
  </table>

</body>
</html>

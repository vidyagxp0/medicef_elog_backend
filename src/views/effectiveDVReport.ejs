<!DOCTYPE html>
<html>

<head>
  <style>
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 13.5px;
      color: #000;
      margin: 20px;
      line-height: 1.5;
    }

    h1 {
      text-align: center;
      font-size: 20px;
      margin-bottom: 20px;
      letter-spacing: 0.5px;
    }

    h2.heading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 15px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }
    h3.subheading {
      display: flex;
      align-items: center;
      font-weight: 600;
      border-left: 4px solid #495057;
      padding: 6px 10px;
      font-size: 14px;
      background-color: #e9ecef;
      margin-bottom: 8px;
      page-break-after: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      page-break-inside: auto;
    }

    th,
    td {
      border: 1px solid #000;
      padding: 6px;
      font-size: 12px;
      vertical-align: top;
    }

    th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: center;
      vertical-align: middle;
    }

    thead {
      display: table-header-group;
    }

    tr {
      page-break-inside: avoid;
    }

    /* DETAILS TABLE */
    .details-table td.label {
      width: 35%;
      font-weight: 600;
      background-color: #f8f9fa;
    }

    .details-table td.value {
      width: 65%;
    }

    /* RECORDS TABLE */
    .records-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      page-break-inside: auto;
    }

    .records-table th,
    .records-table td {
      border: 1px solid #000;
      padding: 5px 4px;
      font-size: 11px;
      vertical-align: middle;
      box-sizing: border-box;
    }

    .records-table th {
      background: #f8f8f8;
      font-weight: 600;
      text-align: center;
      font-size: 11px;
    }

    .col-sno {
      width: 35px;
      text-align: center;
      white-space: nowrap;
    }

    .col-uid {
      width: 70px;
      text-align: center;
      white-space: nowrap;
    }

    .col-date {
      width: 80px;
      text-align: center;
      white-space: nowrap;
    }

    .col-time {
      width: 60px;
      text-align: center;
      white-space: nowrap;
    }

    .col-zero {
      width: 80px;
      text-align: center;
      white-space: nowrap;
    }

    .col-spirit {
      width: 90px;
      text-align: center;
      white-space: nowrap;
    }

    .col-w {
      width: 60px;
      text-align: center;
      white-space: nowrap;
    }

    .col-done {
      min-width: 100px;
      text-align: center;
      white-space: nowrap;
    }

    .col-checked {
      min-width: 100px;
      text-align: center;
      white-space: nowrap;
    }

    .col-verified {
      min-width: 100px;
      text-align: center;
      white-space: nowrap;
    }

    .col-remark {
      min-width: 90px;
      text-align: left;
    }

    .green {
      color: green;
      font-weight: bold;
    }

    .yellow {
      color: orange;
      font-weight: bold;
    }

    .red {
      color: red;
      font-weight: bold;
    }

    .black {
      color: black;
    }
  </style>
</head>

<body>

  <% const formatDateOnly=(date)=> {
    if (!date) return "NA";
    return new Date(date).toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    }).replace(/\//g, "-");    };
    %>

    <!-- ================= DETAILS ================= -->
    <h2 class="heading">Details</h2>

    <table class="details-table">
      <tbody>
        <tr>
          <td class="label">Record Id</td>
          <td class="value">
            MED/DVR/<%= String(reportData?.form_id || 0).padStart(4, '0' ) %>
          </td>
        </tr>
        <tr>
          <td class="label">Area Name</td>
          <td class="value">
            <%= reportData?.area_name || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Room ID</td>
          <td class="value">
            <%= reportData?.room_id || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Balance ID No.</td>
          <td class="value">
            <%= reportData?.balanceIdNo || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Make & Model</td>
          <td class="value">
            <%= reportData?.makeModel || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Balance Capacity</td>
          <td class="value">
            <%= reportData?.balanceCapacity || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Least Count</td>
          <td class="value">
            <%= reportData?.leastCount || "NA" %>
          </td>
        </tr>
        <tr>
          <td class="label">Department</td>
          <td class="value">
            <%= reportData?.departmentName || "NA" %>
          </td>
        </tr>
      </tbody>
    </table>

    <h2 class="heading">Balance Operating Range</h2>
    <table>
      <thead>
        <tr>
          <th>Min. (50X Least count)</th>
          <th>Max. (50X Least count)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= reportData?.balanceOperatingRangeMin || "NA" %></td>
          <td><%= reportData?.balanceOperatingRangeMax || "NA" %></td>
        </tr>
      </tbody>
    </table>

    <h2 class="heading">Acceptance Criteria / Tolerance Limit</h2>
    <table>
      <thead>
        <tr>
          <th>Min. (-0.1%)</th>
          <th>Max. (+0.1%)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= reportData?.acceptanceCriteriaMin || "NA" %></td>
          <td><%= reportData?.acceptanceCriteriaMax || "NA" %></td>
        </tr>
      </tbody>
    </table>

    <h2 class="heading">Standard weight</h2>
    <table>
      <thead>
        <tr>
          <th>W1 (50 x Least count)</th>
          <th>W2 (50% of Balance Capacity)</th>
          <th>W3 (80% of Balance capacity)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= reportData?.standardWeightW1 || "NA" %></td>
          <td><%= reportData?.standardWeightW2 || "NA" %></td>
          <td><%= reportData?.standardWeightW3 || "NA" %></td>
        </tr>
      </tbody>
    </table>

    <h2 class="heading">Standard weight Min / Max</h2>
    <table>
      <thead>
        <tr>
          <th>Standard weight</th>
          <th>Min. (-0.1%)</th>
          <th>Max. (+0.1%)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Standard weight W1</td>
          <td><%= reportData?.standardWeightW1Min || "NA" %></td>
          <td><%= reportData?.standardWeightW1Max || "NA" %></td>
        </tr>
        <tr>
          <td>Standard weight W2</td>
          <td><%= reportData?.standardWeightW2Min || "NA" %></td>
          <td><%= reportData?.standardWeightW2Max || "NA" %></td>
        </tr>
        <tr>
          <td>Standard weight W3</td>
          <td><%= reportData?.standardWeightW3Min || "NA" %></td>
          <td><%= reportData?.standardWeightW3Max || "NA" %></td>
        </tr>
      </tbody>
    </table>

    <!-- ================= RECORDS ================= -->
    <h2 class="heading">Daily Verification Records</h2>
    <% if (reportData.DailyVerificationRecords && reportData.DailyVerificationRecords.length> 0) { %>
      <table class="records-table">
        <thead>
          <tr>
            <th class="col-sno" rowspan="2">S. No.</th>
            <th class="col-uid" rowspan="2">Unique ID</th>
            <th class="col-date" rowspan="2">Date</th>
            <th class="col-time" rowspan="2">Time</th>
            <th class="col-zero" rowspan="2">Zero balance</th>
            <th class="col-spirit" rowspan="2">Spirit level status</th>
            <th colspan="3">Observed Weights</th>
            <th class="col-done" rowspan="2">Done By</th>
            <th class="col-checked" rowspan="2">Checked By</th>
            <th class="col-verified" rowspan="2">Verified By</th>
            <th class="col-remark" rowspan="2">Remark</th>      
          </tr>
          <tr>
            <th class="col-w">W1</th>
            <th class="col-w">W2</th>
            <th class="col-w">W3</th>
          </tr>
        </thead>
        <tbody>

          <% reportData.DailyVerificationRecords.forEach((record, index)=> { %>
            <tr>
              <td class="col-sno">
                <%= index + 1 %>
              </td>
              <td class="col-uid">
                <%= record?.unique_id || "NA" %>
              </td>
              <td class="col-date">
                <%= formatDateOnly(record?.date) || "NA" %>
              </td>
              <td class="col-time">
                <%= record?.time || "NA" %>
              </td>
              <td class="col-zero">
                <%= record?.zeroBalance || "NA" %>
              </td>
              <td class="col-spirit">
                <%= record?.spiritLevelStatus || "NA" %>
              </td>
              <td class="col-w">
                <%= record?.observedWeightsW1 || "NA" %>
              </td>
              <td class="col-w">
                <%= record?.observedWeightsW2 || "NA" %>
              </td>
              <td class="col-w">
                <%= record?.observedWeightsW3 || "NA" %>
              </td>
              <td class="col-done">
                <%= record?.done_by || "NA" %>
              </td>
              <td class="col-checked">
                <% if (record?.reviewed_by) { 
                     const parts = record.reviewed_by.split(" | ");
                %>
                  <div><%= parts[0] %></div>
                  <% if (parts[1]) { %>
                    <div><%= parts[1] %></div>
                  <% } %>
                <% } else { %>
                  NA
                <% } %>
              </td>
              <td class="col-verified">
                <% if (record?.verified_by) { 
                     const parts = record.verified_by.split(" | ");
                %>
                  <div><%= parts[0] %></div>
                  <% if (parts[1]) { %>
                    <div><%= parts[1] %></div>
                  <% } %>
                <% } else { %>
                  NA
                <% } %>
              </td>
              <td class="col-remark">
                <%= record?.remarks || "NA" %>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <p>No Records Found.</p>
      <% } %>

      <!-- ================= ADDITIONAL ================= -->
      <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>

        <h2 class="heading">Additional</h2>
        <table>
          <tr>
            <th>Additional Attachment</th>
            <td>
              <% if (reportData?.additionalAttachment) { %>
                <a href="<%= reportData.additionalAttachment %>" target="_blank">
                  View File
                </a>
              <% } else { %>
                NA
              <% } %>
            </td>
          </tr>

          <tr>
            <th>Additional Info</th>
            <td>
              <%= reportData?.additionalInfo || "NA" %>
            </td>
          </tr>
        </table>

      <% } %>

</body>

</html>
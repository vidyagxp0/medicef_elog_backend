<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 13.5px;
            color: #000;
            margin: 25px;
            line-height: 1.6;
        }

        h1 {
            text-align: center;
            font-size: 20px;
            margin-bottom: 25px;
            letter-spacing: 0.5px;
        }

        h2.heading {
            display: flex;
            align-items: center;
            font-weight: 600;
            border-left: 4px solid #495057;
            padding: 6px 10px;
            font-size: 15px;
            background-color: #e9ecef;
            margin-bottom: 8px;
            page-break-after: avoid;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            /* border: 1px solid #000; */
            page-break-inside: auto;
        }

        th,
        td {
            border: 1px solid #000;
            padding: 8px;
            /* text-align: left; */
            font-size: 13px;
            vertical-align: top;
        }

        th {
            background: #f8f8f8;
            font-weight: 600;
            text-align: left;
        }

        thead {
            display: table-header-group;
        }

        tr {
            page-break-inside: avoid;
        }

        /* 🔥 DETAILS TABLE */
        .details-table td.label {
            width: 35%;
            font-weight: 600;
            background-color: #f8f9fa;
        }

        .details-table td.value {
            width: 65%;
        }

        .green {
            color: green;
            font-weight: bold;
        }

        .yellow {
            color: orange;
            font-weight: bold;
        }

        .red {
            color: red;
            font-weight: bold;
        }

        .black {
            color: black;
        }
    </style>
</head>

<body>

    <% const formatDateTime=(date)=> {
        if (!date) return "Not Applicable";
        return new Date(date).toLocaleString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
        });
        };

        const formatDateOnly = (date) => {
        if (!date) return "Not Applicable";
        return new Date(date).toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
        });
        };
        %>

        <!-- ================= DETAILS ================= -->
        <h2 class="heading">Details</h2>

        <table class="details-table">
            <tbody>
                <tr>
                    <td class="label">Record Id</td>
                    <td class="value">
                        MED/TR/<%= String(reportData?.form_id || 0).padStart(3, '0' ) %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Initiator name</td>
                    <td class="value">
                        <%= reportData?.initiator_name || "Not Applicable" %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Initiation Date</td>
                    <td class="value">
                        <%= formatDateTime(reportData?.date_of_initiation) %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Area Name</td>
                    <td class="value">
                        <%= reportData?.area_name || "Not Applicable" %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Room Id</td>
                    <td class="value">
                        <%= reportData?.room_id || "Not Applicable" %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Instrument ID No</td>
                    <td class="value">
                        <%= reportData?.instrument_id_no || "Not Applicable" %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Department</td>
                    <td class="value">
                        <%= reportData?.departmentName || "Not Applicable" %>
                    </td>
                </tr>
                <!-- <tr>
                    <td class="label">Approver</td>
                    <td class="value">
                        <%= reportData?.approver?.name || "Not Applicable" %>
                    </td>
                </tr>
                <tr>
                    <td class="label">Reviewer</td>
                    <td class="value">
                        <% if (Array.isArray(reportData?.reviewerData) && reportData.reviewerData.length) { %>
                            <%= reportData.reviewerData.map(r=> r.name).join(', ') %>
                                <% } else { %>
                                    Not Applicable
                                    <% } %>
                    </td>
                </tr> -->
                <tr>
                    <td class="label">Description</td>
                    <td class="value">
                        <%= reportData?.description || "Not Applicable" %>
                    </td>
                </tr>
            </tbody>
        </table>

            <% if (reportData?.acceptanceTempData) { %>

                <h2 class="heading">Acceptance Temperature Limits</h2>

                <table>
                    <thead>
                        <tr>
                            <th>Lower Action Limit</th>
                            <th>Lower Allot Limit</th>
                            <th>Lower Acceptance Criteria</th>
                            <th>Upper Action Limit</th>
                            <th>Upper Allot Limit</th>
                            <th>Upper Acceptance Criteria</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>
                                <%= reportData.acceptanceTempData.lowerActionLimit || "NA" %>
                            </td>
                            <td>
                                <%= reportData.acceptanceTempData.lowerAllotLimit || "NA" %>
                            </td>
                            <td>
                                <%= reportData.acceptanceTempData.lowerAcceptanceCriteria || "NA" %>
                            </td>
                            <td>
                                <%= reportData.acceptanceTempData.upperActionLimit || "NA" %>
                            </td>
                            <td>
                                <%= reportData.acceptanceTempData.upperAllotLimit || "NA" %>
                            </td>
                            <td>
                                <%= reportData.acceptanceTempData.upperAcceptanceCriteria || "NA" %>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <% } %>


            <% if (reportData?.relHumidityData) { %>

                <h2 class="heading">Relative Humidity Criteria Limits</h2>

                <table>
                    <thead>
                        <tr>
                            <th>Lower Action Limit</th>
                            <th>Lower Allot Limit</th>
                            <th>Lower Acceptance Criteria</th>
                            <th>Upper Action Limit</th>
                            <th>Upper Allot Limit</th>
                            <th>Upper Acceptance Criteria</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>
                                <%= reportData.relHumidityData.lowerActionLimit || "NA" %>
                            </td>
                            <td>
                                <%= reportData.relHumidityData.lowerAllotLimit || "NA" %>
                            </td>
                            <td>
                                <%= reportData.relHumidityData.lowerAcceptanceCriteria || "NA" %>
                            </td>
                            <td>
                                <%= reportData.relHumidityData.upperActionLimit || "NA" %>
                            </td>
                            <td>
                                <%= reportData.relHumidityData.upperAllotLimit || "NA" %>
                            </td>
                            <td>
                                <%= reportData.relHumidityData.upperAcceptanceCriteria || "NA" %>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <% } %>

        <hr />
        <!-- ================= RECORDS ================= -->
        <h2 class="heading">Tempreture Records</h2>

        <% if (reportData.TempratureRecords && reportData.TempratureRecords.length> 0) { %>
            <table>
                <thead>
                    <tr>
                        <th rowspan="2">S.No</th>
                        <th rowspan="2">Unique ID</th>
                        <th rowspan="2">Date</th>
                        <th rowspan="2">Time</th>
                        <th colspan="2">Tempreture Record</th>
                        <th rowspan="2">Humidity Record</th>
                        <th rowspan="2">Done By</th>
                        <th rowspan="2">Checked By</th>
                        <!-- <th>Supporting Docs</th> -->
                        <th rowspan="2">Remark</th>
                    </tr>
                    <tr>
                        <th>Min</th>
                        <th>Max</th>
                    </tr>
                </thead>
                <tbody>

                    <% reportData.TempratureRecords.forEach((record, index)=> { %>
                        <tr>
                            <td style="word-break: break-word;">
                                <%= index + 1 %>
                            </td>
                            <td >
                                <%= record?.unique_id || "Not Applicable" %>
                            </td>
                            <td style="word-break: break-word;">
                                <%= formatDateOnly(record?.date) || "Not Applicable" %>
                            </td>
                            <td style="word-break: break-word;">
                                <%= record?.time || "Not Applicable" %>
                            </td>
                            <% const minValue=parseFloat(record?.min_temprature_record); 
                            const minLower=parseFloat(reportData?.acceptanceTempData?.lowerAcceptanceCriteria); 
                            const minUpper=parseFloat(reportData?.acceptanceTempData?.upperAcceptanceCriteria);
                            let colorClass='black' ;
                                if (!isNaN(minValue) && !isNaN(minLower) && !isNaN(minUpper)) { 
                                    if (minValue < minLower) {
                                      colorClass='red' ;
                                    } else if (minValue > minUpper) {
                                      colorClass = 'red';
                                    } else {
                                      colorClass = 'green';
                                    }
                                 }
                                %>

                                <td style="word-break: break-word;" class="<%= colorClass %>">
                                    <%= record?.min_temprature_record || "Not Applicable" %>
                                </td>
                            <% const maxValue=parseFloat(record?.max_temprature_record); 
                            const maxLower=parseFloat(reportData?.acceptanceTempData?.lowerAcceptanceCriteria); 
                            const maxUpper=parseFloat(reportData?.acceptanceTempData?.upperAcceptanceCriteria);
                            let maxColorClass='black' ;
                                if (!isNaN(maxValue) && !isNaN(maxLower) && !isNaN(maxUpper)) { 
                                    if (maxValue < maxLower) {
                                      maxColorClass='red' ;
                                    } else if (maxValue > maxUpper) {
                                      maxColorClass = 'red';
                                    } else {
                                      maxColorClass = 'green';
                                    }
                                 }
                                %>                                
                                <td style="word-break: break-word;" class="<%= maxColorClass %>">
                                    <%= record?.max_temprature_record || "Not Applicable" %>
                                </td>

                            <% const humidityValue = parseFloat(record?.humidity_record); 
                            const humidityLower = parseFloat(reportData?.relHumidityData?.lowerAcceptanceCriteria); 
                            const humidityUpper = parseFloat(reportData?.relHumidityData?.upperAcceptanceCriteria);
                            let humidityColorClass = 'black' ;
                                if (!isNaN(humidityValue) && !isNaN(humidityLower) && !isNaN(humidityUpper)) { 
                                    if (humidityValue < humidityLower) {
                                      humidityColorClass='red' ;
                                    } else if (humidityValue > humidityUpper) {
                                      humidityColorClass = 'red';
                                    } else {
                                      humidityColorClass = 'green';
                                    }
                                 }
                                %>                                    
                                <td style="word-break: break-word;" class="<%= humidityColorClass %>">
                                    <%= record?.humidity_record || "Not Applicable" %>
                                </td>
                                <td style="word-break: break-word;">
                                    <%= record?.done_by || "Not Applicable" %>
                                </td>
                                <td style="word-break: break-word;">
                                    <%= record?.reviewed_by || "Not Applicable" %>
                                </td>
                                <!-- <td>
                                    <% if (record?.supporting_docs) { %>
                                        <a href="<%= record.supporting_docs %>" target="_blank">View File</a>
                                    <% } else { %>
                                        Not Applicable
                                    <% } %>
                                    </td> -->
                                <td style="word-break: break-word;">
                                    <%= record?.remarks || "Not Applicable" %>
                                </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
            <% } else { %>
                <p>No Records Found.</p>
                <% } %>

                    <!-- ================= ADDITIONAL ================= -->
                    <% if ( reportData?.additionalAttachment || reportData?.additionalInfo ) { %>
                        <h2 class="heading">Additional</h2>
                        <table>
                            <tr>
                                <th>Additional Attachment</th>
                                <td>
                                    <% if (reportData?.additionalAttachment) { %>
                                        <a href="<%= reportData.additionalAttachment %>" target="_blank">View File</a>
                                        <% } else { %>
                                            Not Applicable
                                            <% } %>
                                </td>
                            </tr>
                            <tr>
                                <th>Additional Info</th>
                                <td>
                                    <%= reportData?.additionalInfo || "Not Applicable" %>
                                </td>
                            </tr>
                        </table>

                        <% } %>

</body>

</html>
<!DOCTYPE html>
<html>

<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            margin: 20px;
            line-height: 1.6;
        }

        .report-content {
            margin-top: 30px;
        }

        h1,
        h2 {
            margin-bottom: 20px;
            text-align: left;
            clear: both;
        }

        h1 {
            font-size: 24px;
        }

        h2 {
            font-size: 18px;
            color: #0066CC;
        }

        p {
            font-size: 14px;
            margin-bottom: 10px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
            border: 1px solid #000;
            page-break-inside: auto;
        }

        th,
        td {
            border: 1px solid #000;
            padding: 10px;
            text-align: left;
        }

        th {
            background-color: #f8f8f8;
            font-weight: bold;
        }

        thead {
            display: table-header-group;
        }

        tfoot {
            display: table-footer-group;
        }

        .heading {
            padding-top: 0px;
        }

        .green {
            color: green;
            font-weight: bold;
        }

        .red {
            color: red;
            font-weight: bold;
        }

        .black {
            color: black;
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div class="report-content">

        <!-- MAIN HEADING -->
        <h2 class="heading">Temperature Process Records</h2>
        <div style="margin-bottom: 10px;">
          <strong>Acceptence Temperature Criteria : </strong> <span><%=reportData.acceptance_temperature%></span>
        </br>
        <strong>Relative Humidity Criteria : </strong> <span><%=reportData.relative_humidity_criteria%></span>
        </div>

        <% if (reportData.TempratureRecords && reportData.TempratureRecords.length > 0) { %>

        <table>
            <thead>
                <tr>
                    <th>Unique Id</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Temperature</th>
                    <th>Humidity</th>
                    <th>Done by</th>
                    <th>Checked By</th>
                    <th>Supporting Documents</th>
                    <th>Remark</th>
                </tr>
            </thead>

            <tbody>
                <% reportData.TempratureRecords.forEach(record => { %>
                <tr>
                    <td><%= record?.unique_id || "Not Applicable" %></td>
                    <td><%= record?.date || "Not Applicable" %></td>
                    <td><%= record?.time || "Not Applicable" %></td>

                    <td class="<%= 
                        record?.temprature_record < reportData?.acceptance_temperature 
                            ? 'green' 
                            : record?.temprature_record > reportData?.acceptance_temperature 
                                ? 'red' 
                                : 'black' 
                    %>">
                        <%= record?.temprature_record || "Not Applicable" %>
                    </td>

                    <td class="<%= 
                        Number(record?.humidity_record) < Number(reportData?.relative_humidity_criteria)
                            ? 'green'
                            : Number(record?.humidity_record) > Number(reportData?.relative_humidity_criteria)
                                ? 'red'
                                : 'black'
                    %>">

                        <%= record?.humidity_record || "Not Applicable" %>
                    </td>

                    <td><%= record?.done_by || "Not Applicable" %></td>
                    <td><%= record?.reviewed_by || "Not Applicable" %></td>

                    <td>
                        <% if (record?.supporting_docs) { %>
                        <a href="<%= record.supporting_docs %>" target="_blank">View File</a>
                        <% } else { %>
                        Not Applicable
                        <% } %>
                    </td>

                    <td><%= record?.remarks || "Not Applicable" %></td>
                </tr>
                <% }) %>
            </tbody>

        </table>

        <% } else { %>
        <p>No Temperature Process Records Found.</p>
        <% } %>
        
        <div class="remarks">
            <h2 class="heading">Additional</h2>

            <table>
                <tr>
                    <th>Additional Attachment</th>
                    <td>
                        <% if (reportData?.additionalAttachment) { %>
                        <a href="<%= reportData.additionalAttachment %>" target="_blank">View File</a>
                        <% } else { %>
                        Not Applicable
                        <% } %>
                    </td>
                </tr>

                <tr>
                    <th>Additional Info</th>
                    <td><%= reportData?.additionalInfo || "Not Applicable" %></td>
                </tr>
            </table>
        </div>

        <hr />

    </div>

</body>

</html>
